---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, REVIEW, KNOWS_ABOUT } from "../data/site";
import { t, langOf, ROUTES, HREFLANG, OG_LOCALE, X_DEFAULT, LANGS, alternatesOf, type RouteKey } from "../i18n";

interface Props {
  title: string;
  description: string;
  page?: RouteKey;     // clé de la page (src/i18n/routes.ts) : adresse, versions linguistiques et hreflang
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  modified?: string;   // date de dernière mise à jour du contenu (AAAA-MM-JJ)
}
const { title, description, page: key, schema = [], noindex = false, modified } = Astro.props;
const lang = langOf(Astro.url.pathname);
const C = t(lang).common;
const M = t(lang).metiers.list;
const htmlLang = HREFLANG[lang];
const path = key ? ROUTES[key][lang] : Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const alternates = key ? alternatesOf(key) : [];
const xDefault = key ? ROUTES[key][X_DEFAULT] : undefined;
const og = new URL({ fr: "/og-image.jpg", nl: "/og-image-nl.jpg", en: "/og-image-en.jpg" }[lang], SITE.url).href;

const org = {
  "@type": ["Organization", "ProfessionalService"],
  "@id": `${SITE.url}/#org`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/app-icon-512.png`,
  image: og,
  slogan: C.slogan,
  description: C.orgDescription,
  foundingDate: SITE.founded,
  vatID: SITE.vatId,
  email: SITE.email,
  telephone: SITE.phones[0].tel,
  contactPoint: SITE.phones.map((p) => ({ "@type": "ContactPoint", contactType: "sales", telephone: p.tel, email: SITE.email, areaServed: p.country, availableLanguage: ["fr", "nl", "en"] })),
  address: { "@type": "PostalAddress", streetAddress: SITE.address.street, postalCode: SITE.address.postalCode, addressLocality: SITE.address.city, addressRegion: SITE.address.region, addressCountry: SITE.address.country },
  areaServed: [
    { "@type": "Country", name: C.countries.BE, identifier: "BE", sameAs: "https://www.wikidata.org/wiki/Q31" },
    { "@type": "Country", name: C.countries.LU, identifier: "LU", sameAs: "https://www.wikidata.org/wiki/Q32" },
  ],
  identifier: { "@type": "PropertyValue", propertyID: "BCE/KBO", value: "0871.430.776" },
  iso6523Code: "0208:0871430776",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: C.catalog,
    itemListElement: M.map((m) => ({ "@type": "Offer", itemOffered: { "@type": "Service", "@id": `${SITE.url}${m.href}#service`, name: m.t, url: `${SITE.url}${m.href}` } })),
  },
  knowsLanguage: ["fr", "nl", "en"],
  knowsAbout: KNOWS_ABOUT,
  sameAs: [SITE.charte, "https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html?ondernemingsnummer=0871430776"],
};
const website = { "@type": "WebSite", "@id": `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, inLanguage: LANGS.map((l) => HREFLANG[l]), publisher: { "@id": `${SITE.url}/#org` } };
const webpage = { "@type": "WebPage", "@id": `${canonical}#page`, url: canonical, name: title, description, inLanguage: htmlLang, isPartOf: { "@id": `${SITE.url}/#website` }, about: { "@id": `${SITE.url}/#org` }, ...(modified ? { dateModified: modified } : {}) };
const graph = { "@context": "https://schema.org", "@graph": [org, website, webpage, ...schema] };
---
<!doctype html>
<html lang={htmlLang} class={REVIEW ? "review" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- transitions entre pages : sens du relevé (vers le haut quand on remonte dans l'arborescence) ; avant tout autre script -->
    <link rel="expect" href="#contenu" blocking="render" />
    <script is:inline>
      // Transitions entre pages : sens du relevé, et glissement du titre et de la photo du métier choisi.
      // Les noms ne sont posés que pour la navigation en cours, sur les éléments visibles, un seul par nom.
      (() => {
        const depth = (u) => new URL(u).pathname.split("/").filter(Boolean).length;
        const visible = (el) => { const r = el.getBoundingClientRect(); return r.height > 0 && r.bottom > 0 && r.top < innerHeight; };
        const mark = (path) => {
          const used = new Set();
          document.querySelectorAll('[data-vt-href="' + path + '"]').forEach((el) => {
            const n = el.dataset.vt;
            if (used.has(n) || !visible(el)) return;
            used.add(n); el.style.viewTransitionName = n; el.style.viewTransitionClass = el.dataset.vtClass || "";
          });
        };
        const clear = () => document.querySelectorAll("[data-vt]").forEach((el) => { el.style.viewTransitionName = ""; el.style.viewTransitionClass = ""; });
        addEventListener("pageswap", (e) => {
          if (!e.viewTransition || !e.activation || !e.activation.entry) return;
          mark(new URL(e.activation.entry.url).pathname);
        });
        addEventListener("pagereveal", (e) => {
          const vt = e.viewTransition, a = window.navigation && navigation.activation;
          if (!vt) return;
          if (a && a.from && a.entry) {
            if (depth(a.entry.url) < depth(a.from.url)) vt.types.add("remonte");
            mark(new URL(a.from.url).pathname);
          }
          vt.finished.finally(clear);
        });
        addEventListener("pageshow", clear);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, SITE.url).href} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, SITE.url).href} />}
    {!noindex && <link rel="alternate" type="text/markdown" href={`${canonical}index.html.md`} title={C.markdown} />}
    {(REVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F6F5F0" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/space-grotesk-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/app-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates.filter((a) => a.code !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.code]} />)}
    <meta property="og:site_name" content="Clixite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={C.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#contenu">{C.skip}</a>
    <Header alternates={alternates} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
