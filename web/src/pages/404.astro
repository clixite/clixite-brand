---
import Base from "../layouts/Base.astro";
import FinalCta from "../components/FinalCta.astro";
---
<Base title="Page introuvable | Clixite" description="Cette page n'existe pas ou plus." path="/404/" noindex>
  <section class="section"><div class="wrap stack" style="--stack: 1.5rem">
    <h1 class="h-display">Ce <span class="x">x</span>-là reste introuvable.</h1>
    <p class="lead">La page demandée n'existe pas ou a changé d'adresse.</p>
    <p><a class="btn btn--primary" href="/">Revenir à l'accueil</a></p>
  </div></section>
  <FinalCta x={false} />
</Base>
