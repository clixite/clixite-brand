---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import CopyMail from "../components/CopyMail.astro";
import LivingX from "../components/LivingX.astro";
import { SITE, bookingHref } from "../data/site";
import { breadcrumb } from "../data/schema";
const crumbs = [{ name: "Accueil", href: "/" }, { name: "Contact", href: "/contact/" }];
const schema = [breadcrumb(crumbs), { "@type": "ContactPage", "@id": `${SITE.url}/contact/#contact`, url: `${SITE.url}/contact/`, about: { "@id": `${SITE.url}/#org` } }];
---
<Base
  title="Contact : Wavre, Belgique et Luxembourg | Clixite"
  description="Appelez le +32 10 31 10 00 ou le +352 20 42 02 02, ou écrivez à nicolas@clixite.be. Clixite SRL, Avenue Reine Astrid 53, 1300 Wavre."
  path="/contact/"
  schema={schema}
>
  <Crumbs items={crumbs} />
  <section id="contact" class="section ct" data-theme="encre" aria-labelledby="ct-title">
    <div class="wrap ct__in">
      <div class="ct__main">
        <h1 id="ct-title" class="ct__title">Quel est votre <span class="x">x</span>&nbsp;?</h1>
        <p class="lead ct__lead">Un premier échange suffit pour le nommer. Vous repartez avec une première piste, même si nous ne travaillons pas ensemble.</p>
        <dl class="ct__list">
          {SITE.phones.map((p) => (
            <div><dt>{p.label}</dt><dd><a class="ct__num" href={`tel:${p.tel}`}>{p.display}</a></dd></div>
          ))}
          <div><dt>Courriel</dt><dd><CopyMail /></dd></div>
          <div><dt>Adresse</dt><dd>{SITE.legalName}<br />{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}, Belgique</dd></div>
          <div><dt>Rendez-vous</dt><dd>À Wavre, chez vous ou en visio, en français, en néerlandais ou en anglais.</dd></div>
        </dl>
        <div class="ct__cta"><a class="btn btn--primary" href={bookingHref()}>Demander un échange par courriel</a></div>
        <p class="small muted">BCE et TVA {SITE.vat}.</p>
      </div>
      <LivingX theme="encre" class="ct__x" />
    </div>
  </section>
</Base>

<style>
  .ct { min-height: 60vh; }
  .ct__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: center; }
  .ct__main { display: grid; gap: var(--clx-space-6); justify-items: start; }
  .ct__title { font-size: var(--clx-type-display-font-size); line-height: var(--clx-type-display-line-height); letter-spacing: var(--clx-type-display-letter-spacing); font-weight: 700; }
  .ct__title .x { color: var(--clx-accent); }
  .ct__list { display: grid; margin: 0; width: 100%; max-width: 40rem; }
  .ct__list div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--clx-space-4); padding-block: var(--clx-space-4); border-top: 1px solid var(--clx-border-strong); }
  .ct__list div:last-child { border-bottom: 1px solid var(--clx-border-strong); }
  .ct__list dt { color: var(--clx-text-muted); }
  .ct__list dd { margin: 0; }
  .ct__num { color: var(--clx-text); font-family: var(--clx-font-family-display); font-size: 1.5rem; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .ct__num:hover { color: var(--clx-link); }
  .ct :global(.ct__x) { width: min(100%, 420px); justify-self: end; }
  @media (max-width: 899px) {
    .ct__in { grid-template-columns: 1fr; }
    .ct :global(.ct__x) { display: none; }
    .ct__list div { grid-template-columns: 1fr; gap: var(--clx-space-1); }
  }
</style>
