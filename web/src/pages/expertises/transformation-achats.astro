---
import Base from "../../layouts/Base.astro";
import FinalCta from "../../components/FinalCta.astro";
import Faq from "../../components/Faq.astro";
import Photo from "../../components/Photo.astro";
import { SITE } from "../../data/site";
import { faqPage } from "../../data/schema";

const scope = [
  { t: "Source-to-Pay, du besoin au paiement", d: "Du besoin au paiement : sourcing, appels d'offres, contrats, commandes, réception et factures. Des processus simples, outillés quand le volume le justifie, avec SAP Ariba ou l'outil qui convient à votre taille, et intégrés à votre ERP." },
  { t: "Direction des achats à temps partagé", d: "Un Fractional CPO présent au rythme que vous fixez : feuille de route, pilotage des appels d'offres stratégiques, montée en compétence de l'équipe. Les pratiques des grands comptes, à la taille de votre entreprise.", av: true },
  { t: "Direction des achats par intérim", d: "Une prise de fonction quand le poste est vacant ou en transformation. On stabilise, on décide, on prépare l'arrivée du titulaire.", av: true },
  { t: "Risques tiers et conformité", d: "Cartographie et suivi des fournisseurs critiques, registre d'information DORA, exigences NIS2 sur la chaîne d'approvisionnement, clauses contractuelles et plans de sortie." },
];
const faq = [
  { q: "Qu'est-ce qu'un Fractional CPO ?", a: "Un directeur des achats expérimenté qui travaille pour votre entreprise à temps partagé, au rythme que vous fixez. Vous accédez à une expertise de grand groupe sans créer un poste à temps plein, et vous ajustez la présence selon la charge." },
  { q: "Le Source-to-Pay est-il utile pour une PME ?", a: "Oui, à condition de commencer par les processus avant les outils. Une PME gagne surtout en visibilité sur ses dépenses, en conditions négociées et en temps de traitement des factures. L'outil vient ensuite, dimensionné à vos volumes." },
  { q: "En quoi le règlement DORA concerne‑t‑il les achats ?", a: "Depuis le 17 janvier 2025, DORA impose aux entités financières de l'Union de tenir un registre d'information sur leurs prestataires de services TIC, d'évaluer leurs risques de concentration et d'inscrire des clauses précises dans les contrats. Les achats sont en première ligne pour collecter ces données et négocier ces clauses." },
  { q: "Clixite travaille-t-elle aussi en néerlandais et en anglais ?", a: "Oui. Les missions se déroulent en français, en néerlandais ou en anglais, selon vos équipes et vos fournisseurs, partout en Belgique et au Luxembourg." },
];
const schema = [
  {
    "@type": "Service",
    "@id": `${SITE.url}/expertises/transformation-achats/#service`,
    name: "Transformation des achats",
    description: "Transformation des achats, du besoin au paiement : processus Source-to-Pay outillés, risques fournisseurs maîtrisés, direction des achats à temps partagé ou par intérim, pour les PME comme pour les groupes régulés.",
    serviceType: ["Source-to-Pay", "Fractional CPO", "Direction des achats par intérim", "Gestion des risques tiers", "Conformité DORA des achats"],
    provider: { "@id": `${SITE.url}/#org` },
    areaServed: [{ "@type": "Country", name: "Belgique" }, { "@type": "Country", name: "Luxembourg" }],
    availableLanguage: ["fr", "nl", "en"],
    url: `${SITE.url}/expertises/transformation-achats/`,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Expertises", item: `${SITE.url}/expertises/` },
      { "@type": "ListItem", position: 3, name: "Transformation des achats", item: `${SITE.url}/expertises/transformation-achats/` },
    ],
  },
  faqPage(faq),
];
---
<Base
  title="Transformation des achats et Source-to-Pay | Clixite"
  description="Source-to-Pay, Fractional CPO, intérim, risques tiers et DORA : Clixite structure vos achats, de la PME au groupe régulé, en Belgique et au Luxembourg."
  path="/expertises/transformation-achats/"
  schema={schema}
>
  <nav class="wrap crumbs small" aria-label="Fil d'Ariane">
    <ol role="list"><li><a href="/">Accueil</a></li><li><a href="/expertises/">Expertises</a></li><li aria-current="page">Transformation des achats</li></ol>
  </nav>

  <section class="ach-hero" aria-labelledby="ach-title">
    <div class="wrap ach-hero__in">
      <h1 id="ach-title" class="h-display">Des achats qui pèsent dans les décisions.</h1>
      <div>
        <p class="lead">
          Transformation des achats, du besoin au paiement : processus Source-to-Pay outillés, risques fournisseurs maîtrisés, une direction des achats disponible à temps partagé ou par intérim.
          Pour les PME qui structurent leurs achats comme pour les groupes régulés.
        </p>
        <div class="ach-hero__cta">
          <a class="btn btn--primary" href="#contact">Parler de vos achats</a>
          <a class="btn btn--secondary" href="#offres-achats">Voir les formules</a>
        </div>
      </div>
    </div>
    <div class="wrap"><div class="ph ach-hero__ph"><Photo name="conteneurs-32" eager sizes="(min-width: 1360px) 1280px, 100vw" /></div></div>
  </section>

  <section class="section ach-scope band-alt" aria-labelledby="scope-title">
    <div class="wrap">
      <h2 id="scope-title" class="h2">Ce que nous prenons en charge.</h2>
      <ul role="list" class="ach-scope__grid">
        {scope.map((s) => (
          <li>
            <h3 class="h3">{s.t}</h3>
            <p class={s.av ? "muted av" : "muted"}>{s.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <section id="offres-achats" class="section ach-offers" aria-labelledby="ach-offers-title">
    <div class="wrap">
      <h2 id="ach-offers-title" class="h2">Trois formules, un même niveau d'exigence.</h2>
      <p class="lead ach-offers__lead">Le périmètre, la durée et le budget se fixent ensemble après un premier échange. Vous hésitez entre les formules ? <a href="#contact">Un premier échange suffit pour la choisir</a>.</p>
      <ul role="list" class="ach-offers__grid">
        <li class="panel">
          <h3 class="h3">Diagnostic achats</h3>
          <p class="muted">Cartographie des dépenses, maturité des processus, risques fournisseurs et gains rapides chiffrés.</p>
          <a class="link-more ach-ask" href="#contact">Demander le diagnostic</a>
        </li>
        <li class="panel">
          <h3 class="h3">Fractional CPO</h3>
          <p class="muted">Une direction des achats présente, une feuille de route tenue, des appels d'offres pilotés.</p>
          <a class="link-more ach-ask" href="#contact">Parler d'un Fractional CPO</a>
        </li>
        <li class="panel">
          <h3 class="h3">Intérim de direction</h3>
          <p class="muted">La fonction tenue et transformée pendant la vacance du poste, puis transmise.</p>
          <a class="link-more ach-ask" href="#contact">Parler d'un intérim</a>
        </li>
      </ul>
    </div>
  </section>

  <Faq id="faq-title" items={faq} />

  <FinalCta />
</Base>

<style>
  .crumbs { padding-top: var(--clx-space-5); color: var(--clx-text-muted); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; }
  .crumbs li { white-space: nowrap; }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: var(--clx-border-strong); }
  .crumbs a { color: var(--clx-text-muted); }
  .ach-hero { padding-block: var(--clx-space-7) var(--clx-layout-section); }
  .ach-hero__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: end; }
  .ach-hero__ph { aspect-ratio: 21 / 9; margin-top: var(--clx-space-8); }
  .ach-hero__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); margin-top: var(--clx-space-6); }
  .ach-scope__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--clx-space-8) var(--clx-space-8); margin-top: var(--clx-space-8); }
  .ach-scope__grid p { margin-top: var(--clx-space-3); max-width: 52ch; }
  .ach-offers__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-5); margin-top: var(--clx-space-8); }
  .ach-offers__grid .panel { display: flex; flex-direction: column; gap: var(--clx-space-3); padding: var(--clx-space-6); }
  .ach-ask { margin-top: auto; padding-top: var(--clx-space-2); align-self: flex-start; }
  .ach-offers__lead a { color: var(--clx-text); text-decoration: underline; text-underline-offset: 0.2em; }
  .ach-offers__lead { margin-top: var(--clx-space-4); max-width: 52ch; }
  @media (max-width: 899px) {
    .ach-hero__in { grid-template-columns: 1fr; gap: var(--clx-space-6); }
    .ach-hero__ph { aspect-ratio: 3 / 2; margin-top: var(--clx-space-7); }
    .ach-scope__grid, .ach-offers__grid { grid-template-columns: 1fr; gap: var(--clx-space-6); }
  }
</style>
