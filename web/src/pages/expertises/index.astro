---
import Base from "../../layouts/Base.astro";
import Expertises from "../../components/Expertises.astro";
import Formats from "../../components/Formats.astro";
import FinalCta from "../../components/FinalCta.astro";
import { SITE } from "../../data/site";
const schema = [{
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Expertises", item: `${SITE.url}/expertises/` },
  ],
}];
---
<Base
  title="Expertises : digitalisation, Forward Deployed Engineering, programmes et architecture | Clixite"
  description="Les quatre métiers de Clixite : digitalisation, Forward Deployed Engineering, pilotage de programmes, architecture d'entreprise et de solutions. Appliqués aux achats, à la conformité DORA et NIS2 et à l'IA en production."
  path="/expertises/"
  schema={schema}
>
  <nav class="wrap crumbs small" aria-label="Fil d'Ariane">
    <ol role="list"><li><a href="/">Accueil</a></li><li aria-current="page">Expertises</li></ol>
  </nav>
  <Expertises headingLevel="h1" />
  <Formats />
  <FinalCta />
</Base>

<style>
  .crumbs { padding-top: var(--clx-space-5); color: var(--clx-text-muted); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; }
  .crumbs li { white-space: nowrap; }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: var(--clx-border-strong); }
  .crumbs a { color: var(--clx-text-muted); }
</style>
