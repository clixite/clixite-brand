---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import ClientLogos from "../components/ClientLogos.astro";
import Solver from "../components/Solver.astro";
import Offers from "../components/Offers.astro";
import Proofs from "../components/Proofs.astro";
import Quotes from "../components/Quotes.astro";
import Profile from "../components/Profile.astro";
import Skills from "../components/Skills.astro";
import Method from "../components/Method.astro";
import FinalCta from "../components/FinalCta.astro";
---
<Base
  title="Architecte d'entreprise et de solutions à Wavre | Clixite"
  description="Clixite (Wavre, depuis 2005) conçoit votre architecture d'entreprise et de solutions, puis la met en production avec vos équipes : achats, DORA, NIS2, IA. Pour les grands groupes et les PME."
  path="/"
  audienceMode
>
  <Hero />
  <Intro />
  <ClientLogos />
  <Solver />
  <Offers />
  <Proofs />
  <Quotes />
  <Profile />
  <Skills collapsible />
  <Method />
  <FinalCta />
</Base>
