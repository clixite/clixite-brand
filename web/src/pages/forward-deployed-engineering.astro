---
import Base from "../layouts/Base.astro";
import FdePage from "../components/FdePage.astro";
import { FDE, FDE_UPDATED } from "../data/fde";
import { FDE_PATH, FDE_PATH_EN, SITE } from "../data/site";
import { breadcrumb, faqPage, service } from "../data/schema";
const C = FDE.fr;
const schema = [
  {
    ...service({
      path: FDE_PATH, name: "Forward Deployed Engineering", alternateName: ["FDE", "Forward Deployed Engineer", "Ingénieur déployé chez le client"],
      description: C.chapo, serviceType: ["Forward Deployed Engineering", "Intégration de systèmes", "Automatisation des processus", "Mise en production de l'IA", "Agents IA"],
    }),
    subjectOf: { "@id": `${SITE.url}${FDE_PATH}#page` },
  },
  {
    "@type": "DefinedTerm", "@id": `${SITE.url}${FDE_PATH}#terme`, name: "Forward Deployed Engineering", alternateName: "FDE", inLanguage: "fr-BE",
    description: "Modèle d'ingénierie qui installe des ingénieurs dans les équipes d'un client pour concevoir, construire et mettre en production une solution sur ses systèmes, puis la lui transférer.",
    url: `${SITE.url}${FDE_PATH}`,
  },
  breadcrumb(C.crumbs),
  faqPage(C.faq),
];
const alternates = [{ lang: "fr-BE", path: FDE_PATH }, { lang: "en", path: FDE_PATH_EN }];
---
<Base title={C.title} description={C.description} path={FDE_PATH} schema={schema} alternates={alternates} xDefault={FDE_PATH_EN} modified={FDE_UPDATED}>
  <FdePage lang="fr" />
</Base>
