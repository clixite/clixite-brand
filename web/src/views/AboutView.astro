---
// Fiche d'identité de l'entreprise et de la personne qui répond : les faits que les moteurs et les assistants doivent retrouver partout à l'identique.
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Photo from "../components/Photo.astro";
import FinalCta from "../components/FinalCta.astro";
import { SITE } from "../data/site";
import { breadcrumb } from "../data/schema";
import { t, langOf, ROUTES } from "../i18n";
const lang = langOf(Astro.url.pathname);
const { common, metiers, autres } = t(lang);
const A = autres.about;
const F = A.facts;
const path = ROUTES.about[lang];
const crumbs = [{ name: common.crumbs.home, href: ROUTES.home[lang] }, { name: A.crumb, href: path }];
const schema = [breadcrumb(crumbs), { "@type": "AboutPage", "@id": `${SITE.url}${path}#about`, url: `${SITE.url}${path}`, about: { "@id": `${SITE.url}/#org` }, mainEntity: { "@id": `${SITE.url}/#org` } }];
// aucune donnée inventée : les faits viennent de data/site.ts (fondation, siège, TVA, zone, langues, certifications)
const facts = [
  [F.legal, `${SITE.legalName}, ${F.legalValue}`],
  [F.founded, SITE.founded],
  [F.seat, `${SITE.address.street}, ${SITE.address.postalCode} ${SITE.address.city} (${F.region})`],
  [F.vat, SITE.vat],
  [F.area, F.areaValue],
  [F.langs, F.langsValue],
  [F.phones, SITE.phones.map((p) => `${common.countries[p.country]} ${p.display}`).join(lang === "fr" ? "\u00a0; " : "; ")],
  [F.email, SITE.email],
  [F.frameworks, SITE.founder.certifications.join(", ")],
];
---
<Base title={A.title} description={A.description} page="about" schema={schema}>
  <Crumbs items={crumbs} />
  <section class="ap-head" aria-labelledby="ap-title">
    <div class="wrap ap-head__in">
      <div class="ap-head__text">
        <h1 id="ap-title" class="h-display">{A.h1}</h1>
        <p class="lead">{A.lead}</p>
        <p class="lead">{A.rule[0]}<span class="x">{A.rule[1]}</span>{A.rule[2]}</p>
      </div>
      <div class="ph ap-head__ph"><Photo name="plan-32" eager sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section ap-who" aria-labelledby="ap-who-title">
    <div class="wrap ap-cols">
      <div class="ap-prose">
        <h2 id="ap-who-title" class="h2">{A.who.title}</h2>
        <p class="lead">{A.who.lead}</p>
        <p class="ap-who__name">{SITE.founder.name}</p>
        <p class="muted">{SITE.founder.jobTitle}</p>
        <p><a class="link-more" href={SITE.linkedin} rel="me">{A.who.link}</a></p>
      </div>
      <dl class="ap-dl">
        <div><dt>{A.who.certs}</dt><dd>{SITE.founder.certifications.join(", ")}</dd></div>
        <div><dt>{A.who.langs}</dt><dd>{F.langsValue}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section ap-facts band-alt" aria-labelledby="ap-facts">
    <div class="wrap ap-cols">
      <h2 id="ap-facts" class="h2">{A.factsTitle}</h2>
      <dl class="ap-dl">{facts.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}</dl>
    </div>
  </section>

  <section class="section ap-metiers" aria-labelledby="ap-metiers">
    <div class="wrap ap-cols">
      <h2 id="ap-metiers" class="h2">{A.metiersTitle}</h2>
      <ul class="ap-list">{metiers.list.map((m) => <li><a href={m.href}>{m.t}</a><span class="muted"> {m.k}</span></li>)}</ul>
    </div>
  </section>

  <section class="section ap-env band-alt" aria-labelledby="ap-env">
    <div class="wrap ap-cols">
      <h2 id="ap-env" class="h2">{A.envTitle}</h2>
      <div class="ap-prose">
        <p class="lead">{A.env}</p>
        <p><a class="link-more" href={A.envLink.href}>{A.envLink.t}</a></p>
        <p class="muted">{A.charte} <a href={SITE.charte}>charte.clixite.be</a>.</p>
      </div>
    </div>
  </section>

  <FinalCta />
</Base>

<style>
  .ap-head { padding-block: var(--clx-space-7) var(--clx-layout-section); }
  .ap-head__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: center; }
  .ap-head__text { display: grid; gap: var(--clx-space-5); }
  .ap-head__text .lead { max-width: 52ch; }
  .ap-head__text .x { color: var(--clx-link); }
  .ap-head__ph { aspect-ratio: 3 / 2; }
  .ap-cols { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--clx-space-8); align-items: start; }
  .ap-who__name { font-family: var(--clx-font-family-display); font-size: 1.375rem; font-weight: 500; letter-spacing: -0.01em; }
  .ap-dl { margin: 0; display: grid; }
  .ap-dl div { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: var(--clx-space-4); padding-block: var(--clx-space-4); border-top: 1px solid var(--clx-border); }
  .ap-dl div:last-child { border-bottom: 1px solid var(--clx-border); }
  .ap-dl dt { color: var(--clx-text-muted); }
  .ap-dl dd { margin: 0; color: var(--clx-text); }
  .ap-list { display: grid; gap: 0; padding: 0; list-style: none; }
  .ap-list li { padding-block: var(--clx-space-4); border-top: 1px solid var(--clx-border); display: grid; gap: var(--clx-space-1); }
  .ap-list li:last-child { border-bottom: 1px solid var(--clx-border); }
  .ap-list a { font-family: var(--clx-font-family-display); font-size: 1.25rem; font-weight: 500; color: var(--clx-text); text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .ap-list .muted { font-size: var(--clx-type-small-font-size); }
  .ap-prose { display: grid; gap: var(--clx-space-4); }
  /* sur Papier 200, les liens prennent la couleur du texte et un soulignement turquoise (contraste AA) */
  .ap-env a { color: var(--clx-text); text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  @media (max-width: 899px) {
    .ap-head__in, .ap-cols { grid-template-columns: 1fr; gap: var(--clx-space-6); }
    .ap-dl div { grid-template-columns: 1fr; gap: var(--clx-space-1); }
  }
</style>
