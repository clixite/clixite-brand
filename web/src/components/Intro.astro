---
// Juste sous le hero : la promesse détaillée pour l'acheteur choisi, et la personne qui la tient.
import { AUDIENCES, HERO } from "../data/audiences";
import { SITE } from "../data/site";
---
<section class="intro" aria-label="En bref">
  <div class="wrap intro__in">
    <div class="intro__text">
      {AUDIENCES.map((a) => <p class="intro__lead" data-aud={a.key}>{HERO[a.key].lead}</p>)}
    </div>
    <div class="intro__who">
      <p class="intro__name">{SITE.founder.name}</p>
      <p class="intro__role">Enterprise &amp; Solution Architect et Forward Deployed Engineer. {SITE.legalName}, à Wavre depuis {SITE.founded}.</p>
      <p class="intro__links"><a class="link-more" href="/nicolas-simon/">Voir le profil</a> <a class="link-more" href={SITE.linkedin} rel="me noopener">LinkedIn</a></p>
    </div>
  </div>
</section>

<style>
  .intro { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); }
  .intro__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--clx-space-8); align-items: end; }
  .intro__lead { font-family: var(--clx-font-family-display); font-weight: 500; font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem); line-height: 1.3; letter-spacing: -0.01em; max-width: 36ch; text-wrap: pretty; }
  .intro__who { display: grid; gap: var(--clx-space-2); padding-top: var(--clx-space-4); border-top: 2px solid var(--clx-text); }
  .intro__name { font-family: var(--clx-font-family-display); font-weight: 700; font-size: 1.25rem; }
  .intro__role { color: var(--clx-text-muted); max-width: 34ch; }
  .intro__links { display: flex; flex-wrap: wrap; gap: var(--clx-space-5); margin-top: var(--clx-space-2); }
  @media (max-width: 899px) {
    .intro__in { grid-template-columns: 1fr; gap: var(--clx-space-6); }
  }
</style>
