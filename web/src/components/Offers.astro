---
import { bookingHref } from "../data/site";
const offers = [
  { t: "Diagnostic d'architecture", dur: "10 jours", d: "Une photographie honnête de vos systèmes, de vos flux et de vos risques, et trois options chiffrées pour la suite.", g: ["Cartographie applicative et des flux", "Risques et dette prioritaires", "Trois scénarios chiffrés, une recommandation"] },
  { t: "Revue d'architecture", dur: "5 jours", d: "Un regard indépendant sur un projet en cours ou un choix de solution, avant qu'il ne coûte trop cher.", g: ["Lecture critique du dossier et entretiens", "Points de rupture et alternatives", "Avis écrit, présenté à votre comité"] },
  { t: "IA en production", dur: "4 semaines", d: "Un cas d'usage IA, de l'idée au service en production, en Forward Deployed Engineer dans votre équipe.", g: ["Cadrage du cas et des données", "Mise en production avec garde-fous", "Mesure, documentation et transfert"] },
];
---
<section id="offres" class="section offers" aria-labelledby="offers-title">
  <div class="wrap">
    <div class="offers__head">
      <h2 id="offers-title" class="h2">Trois façons de commencer cette semaine.</h2>
      <p class="lead">Un périmètre court, un prix fixe annoncé avant de commencer, un résultat que vous gardez même si nous nous arrêtons là. <span class="av">Prix communiqués après le premier échange.</span></p>
    </div>
    <ul role="list" class="offers__grid">
      {offers.map((o) => (
        <li class="panel offers__card">
          <div class="offers__top">
            <h3 class="h3">{o.t}</h3>
            <p class="data offers__dur av">{o.dur}</p>
          </div>
          <p class="muted">{o.d}</p>
          <ul class="offers__gets">
            {o.g.map((x) => <li>{x}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="offers__cta"><a class="btn btn--primary" href={bookingHref()}>Choisir avec nous en 30 minutes</a></p>
  </div>
</section>

<style>
  .offers__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--clx-space-7); align-items: end; }
  .offers__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-5); margin-top: var(--clx-space-8); }
  .offers__card { display: flex; flex-direction: column; gap: var(--clx-space-4); padding: var(--clx-space-6); }
  .offers__top { display: flex; justify-content: space-between; gap: var(--clx-space-3); align-items: baseline; }
  .offers__dur { color: var(--clx-link); white-space: nowrap; }
  .offers__gets { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; }
  .offers__gets li::marker { color: var(--clx-accent); }
  .offers__cta { margin-top: var(--clx-space-7); }
  @media (max-width: 1099px) { .offers__grid { grid-template-columns: 1fr; max-width: 40rem; } }
  @media (max-width: 899px) { .offers__head { grid-template-columns: 1fr; gap: var(--clx-space-4); } }
</style>
