---
import { SITE, bookingHref } from "../data/site";
import { AUDIENCES, OFFERS } from "../data/audiences";
const ask = (o: string) => SITE.bookingsUrl || `mailto:${SITE.email}?subject=${encodeURIComponent(o + " : premier échange")}`;
const heads = {
  groupe: { h: "Trois façons de travailler ensemble.", l: "Une mission longue sur un rôle clair, ou un livrable court qui éclaire une décision. En direct ou via votre cabinet référencé." },
  pme: { h: "Trois façons de commencer, sans engagement long.", l: "Un périmètre court, un prix annoncé avant de commencer, un résultat que vous gardez même si nous nous arrêtons là." },
  cabinet: { h: "Pour vos clients, un profil prêt à partir.", l: "Rôles, formats et dossier de candidature : tout ce qu'il faut pour proposer Nicolas Simon à un client cette semaine." },
} as const;
---
<section id="offres" class="section offers" aria-labelledby="offers-title">
  <div class="wrap">
    {AUDIENCES.map((a, i) => (
      <div class="offers__head" data-aud={a.key}>
        <h2 id={i === 0 ? "offers-title" : undefined} class="h2">{heads[a.key].h}</h2>
        <p class="lead">{heads[a.key].l} <span class="av">Prix et durées confirmés après le premier échange.</span></p>
      </div>
    ))}
    {AUDIENCES.map((a) => (
      <ul role="list" class="offers__grid" data-aud={a.key}>
        {OFFERS[a.key].map((o) => (
          <li class="panel offers__card">
            <div class="offers__top">
              <h3 class="h3">{o.t}</h3>
              <p class="data offers__dur av">{o.dur}</p>
            </div>
            <p class="muted">{o.d}</p>
            <ul class="offers__gets">
              {o.g.map((x) => <li>{x}</li>)}
            </ul>
            <a class="link-more offers__ask" href={ask(o.t)}>{o.cta}</a>
          </li>
        ))}
      </ul>
    ))}
    <div class="offers__foot">
      <p class="offers__cta"><a class="btn btn--primary" href={bookingHref()}>Choisir avec nous en 30 minutes</a></p>
      <dl class="offers__terms small av">
        <div><dt>Contrat</dt><dd>En direct, ou via les sociétés de conseil référencées chez vous.</dd></div>
        <div><dt>Confidentialité</dt><dd>Accord de confidentialité signé avant l'échange si vous le souhaitez.</dd></div>
        <div><dt>Assurance</dt><dd>Responsabilité civile professionnelle.</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .offers__head { display: grid; gap: var(--clx-space-5); max-width: 52rem; }
  .offers__head .lead { max-width: 46ch; }
  .offers__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-5); margin-top: var(--clx-space-8); }
  .offers__card { display: flex; flex-direction: column; gap: var(--clx-space-4); padding: var(--clx-space-6); }
  .offers__top { display: flex; justify-content: space-between; gap: var(--clx-space-3); align-items: baseline; }
  .offers__dur { color: var(--clx-link); white-space: nowrap; }
  .offers__gets { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; }
  .offers__gets li::marker { color: var(--clx-accent); }
  .offers__ask { margin-top: auto; padding-top: var(--clx-space-2); align-self: flex-start; }
  .offers__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--clx-space-6); margin-top: var(--clx-space-7); }
  .offers__terms { display: grid; grid-template-columns: repeat(3, minmax(0, 14rem)); gap: var(--clx-space-5); color: var(--clx-text-muted); }
  .offers__terms dt { font-weight: 600; color: var(--clx-text); }
  @media (max-width: 899px) { .offers__terms { grid-template-columns: 1fr; } }
  @media (max-width: 1099px) { .offers__grid { grid-template-columns: 1fr; max-width: 40rem; } }
  @media (max-width: 899px) { .offers__head { grid-template-columns: 1fr; gap: var(--clx-space-4); } }
</style>
