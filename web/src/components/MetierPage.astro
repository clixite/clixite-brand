---
// Page métier générique (GEO, architecture, pilotage, digitalisation). Contenu : src/i18n/<langue>/pages.ts.
import Crumbs from "./Crumbs.astro";
import Photo from "./Photo.astro";
import Faq from "./Faq.astro";
import FinalCta from "./FinalCta.astro";
import e1 from "../assets/x/etape-1.svg?raw";
import e2 from "../assets/x/etape-2.svg?raw";
import e3 from "../assets/x/etape-3.svg?raw";
import e4 from "../assets/x/etape-4.svg?raw";
import type { PageMetier } from "../i18n/fr/pages";
import { t, langOf, ROUTES } from "../i18n";
interface Props { page: PageMetier }
const { page: P } = Astro.props;
const lang = langOf(Astro.url.pathname);
const { common, metiers } = t(lang);
const arts = [e1, e2, e3, e4];
const others = metiers.list.filter((m) => m.key !== P.key);
// le GEO est à la racine de chaque langue ; les autres métiers sous les expertises
const crumbs = [{ name: common.crumbs.home, href: ROUTES.home[lang] }, ...(P.key !== "geo" ? [{ name: common.crumbs.expertises, href: ROUTES.expertises[lang] }] : []), { name: P.crumb, href: P.path }];
---
<Crumbs items={crumbs} />

<section class="mp-head" aria-labelledby="mp-title">
  <div class="wrap mp-head__in">
    <div class="mp-head__text">
      <h1 id="mp-title" class="mp-head__title"><span class="mp-head__term">{P.h1[0]}</span><span class="mp-head__claim">{P.h1[1]}</span></h1>
      <p class="mp-head__chapo">{P.chapo}</p>
      <div class="mp-head__cta">
        <a class="btn btn--primary" href="#contact">{common.cta}</a>
      </div>
      <p class="small muted"><time datetime="2026-10-26">{common.updated}</time></p>
    </div>
    <div class="ph mp-head__ph" style={`view-transition-name: ph-${P.slug}; view-transition-class: clx-morph clx-morph-ph`}><Photo name={P.photo} eager sizes="(min-width: 900px) 40vw, 100vw" /></div>
  </div>
</section>

{P.blocs.map((b) => (
  <section id={b.id} class:list={["section", "mp-bloc", b.band && "band-alt"]} data-theme={b.encre ? "encre" : undefined} aria-labelledby={`${b.id}-t`}>
    <div class:list={["wrap", b.kind === "steps" ? "mp-steps-wrap" : "mp-cols"]}>
      <div class="mp-bloc__head">
        <h2 id={`${b.id}-t`} class="h2">{b.h}</h2>
        {b.lead && <p class="lead">{b.lead}</p>}
      </div>
      {b.kind === "prose" && (
        <div class="mp-prose">
          {b.p?.map((x) => <p>{x}</p>)}
          {b.src && <p class="small muted">{b.src.length > 1 ? common.sources : common.source}{common.colon} {b.src.map((s, i) => <>{i > 0 && ", "}<a href={s.href} rel="noopener">{s.t}</a></>)}.</p>}
          {b.link && <p><a class="link-more" href={b.link.href}>{b.link.t}</a></p>}
        </div>
      )}
      {b.kind === "note" && <div class="mp-prose mp-note">{b.p?.map((x, i) => <p class={i === 0 ? "mp-note__voice" : undefined}>{x}</p>)}</div>}
      {b.kind === "list" && <ul class="mp-list">{b.items?.map((x) => <li>{x}</li>)}</ul>}
      {b.kind === "defs" && <dl class="mp-defs">{b.defs?.map((x) => <div><dt class="h3">{x.t}</dt><dd class="muted">{x.d}</dd></div>)}</dl>}
      {b.kind === "steps" && (
        <ol role="list" class="mp-steps">
          {b.steps?.map((s, i) => (
            <li class="mp-step">
              <div class="mp-step__art" set:html={arts[i % 4]} />
              <h3 class="h3">{s.t}</h3>
              <p class="muted">{s.d}</p>
              <p class="mp-step__out small"><span>{common.deliverable}</span> <span>{s.out}</span></p>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
))}

<Faq id="mp-faq" items={P.faq} />

<section class="section section--tight mp-others" aria-labelledby="mp-others">
  <div class="wrap">
    <h2 id="mp-others" class="h3">{common.others}</h2>
    <ul role="list" class="mp-others__list">{others.map((m) => <li><a href={m.href}>{m.t}</a></li>)}</ul>
  </div>
</section>

<FinalCta />

<style>
  .mp-head { padding-block: var(--clx-space-7) var(--clx-layout-section); }
  .mp-head__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: center; }
  .mp-head__text { display: grid; gap: var(--clx-space-5); justify-items: start; }
  .mp-head__title { font-weight: 700; }
  .mp-head__term { display: block; font-size: var(--clx-type-h1-font-size); line-height: var(--clx-type-h1-line-height); letter-spacing: var(--clx-type-h1-letter-spacing); }
  .mp-head__claim { display: block; margin-top: var(--clx-space-3); font-size: var(--clx-type-h3-font-size); line-height: 1.25; font-weight: 500; color: var(--clx-text-muted); max-width: 32ch; }
  .mp-head__chapo { font-size: var(--clx-type-lead-font-size); line-height: var(--clx-type-lead-line-height); color: var(--clx-text); max-width: 54ch; }
  .mp-head__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); }
  .mp-head__ph { aspect-ratio: 4 / 5; }

  .mp-cols { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--clx-space-8); align-items: start; }
  .mp-bloc__head { display: grid; gap: var(--clx-space-4); }
  .mp-steps-wrap .mp-bloc__head { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--clx-space-7); align-items: end; }
  .mp-prose { display: grid; gap: var(--clx-space-4); max-width: 62ch; }
  .mp-note__voice { font-family: var(--clx-font-family-voice); font-style: italic; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); line-height: 1.35; color: var(--clx-text); }
  .mp-note p:not(.mp-note__voice) { color: var(--clx-text-muted); }
  .mp-list { display: grid; gap: var(--clx-space-4); padding: 0; list-style: none; }
  .mp-list li { position: relative; padding: 0 0 var(--clx-space-4) 2rem; border-bottom: 1px solid var(--clx-border); max-width: 62ch; }
  .mp-list li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 1.1rem; height: 2px; background: var(--clx-accent); }
  .mp-defs { display: grid; margin: 0; }
  .mp-defs div { padding-block: var(--clx-space-5); border-top: 1px solid var(--clx-border); }
  .mp-defs div:last-child { border-bottom: 1px solid var(--clx-border); }
  .mp-defs dt { font-size: 1.25rem; }
  .mp-defs dd { margin: var(--clx-space-2) 0 0; max-width: 56ch; }
  .mp-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--clx-space-6); margin-top: var(--clx-space-8); }
  .mp-step { display: flex; flex-direction: column; }
  .mp-step__art { color: var(--clx-text); width: min(100%, 160px); aspect-ratio: 1; margin-bottom: var(--clx-space-5); }
  .mp-step__art :global(svg) { width: 100%; height: 100%; }
  .mp-step p.muted { margin-top: var(--clx-space-3); margin-bottom: var(--clx-space-4); }
  .mp-step__out { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding-top: var(--clx-space-3); border-top: 1px solid var(--clx-border); font-weight: 600; }
  .mp-step__out span + span { font-weight: 500; color: var(--clx-text-muted); }
  .mp-others__list { display: flex; flex-wrap: wrap; gap: var(--clx-space-3) var(--clx-space-7); margin-top: var(--clx-space-4); }
  .mp-others__list a { color: var(--clx-text); text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; font-weight: 500; }
  @media (max-width: 1099px) { .mp-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--clx-space-8); } }
  @media (max-width: 899px) {
    .mp-head__in, .mp-cols, .mp-steps-wrap .mp-bloc__head { grid-template-columns: 1fr; gap: var(--clx-space-6); }
    .mp-head__ph { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 599px) {
    .mp-steps { grid-template-columns: 1fr; gap: var(--clx-space-7); }
    .mp-step { display: grid; grid-template-columns: 88px minmax(0, 1fr); column-gap: var(--clx-space-5); align-items: start; }
    .mp-step__art { grid-row: span 3; width: 88px; margin: 0; }
  }
</style>
