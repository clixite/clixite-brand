---
// Hero cinéma : le film de lancement en boucle, plein cadre et bien visible.
// Le texte se pose sur une plaque Encre, comme les titres du film ; les quatre phrases du film défilent en synchronisation.
// Boucle sans titres ni logo (video/hero_loop.py) : large (1280, 1920 sur écran retina) et verticale, en H.264 et en VP9.
// Le film arrive après une intention (défilement, clic, touche) ou 6 s de calme, jamais en mouvement réduit
// ni en économie de données ; il reste toujours en pause possible.
import { t, langOf } from "../i18n";
const lang = langOf(Astro.url.pathname);
const { home, common } = t(lang);
const H = home.hero;
const STORY = H.story;
---
<section class="hero" data-theme="encre" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(max-aspect-ratio: 4/5)" srcset="/video/hero-720x1280.webp" width="720" height="1280" />
      <img class="hero__poster" src="/video/hero-1920.webp" alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <video class="hero__video" muted playsinline loop preload="none" disablepictureinpicture disableRemotePlayback tabindex="-1"
      data-hero-video data-wide="/video/hero-1280" data-wide-retina="/video/hero-1920" data-tall="/video/hero-720x1280"></video>
  </div>

  <button type="button" class="hero__pause" data-hero-pause aria-pressed="false" data-l-pause={common.film.pause} data-l-play={common.film.play} hidden>
    <svg class="hero__pause-i" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path class="i-pause" d="M2 1h3v10H2zM7 1h3v10H7z" /><path class="i-play" d="M2.5 1l8.5 5-8.5 5z" /></svg><span data-hero-pause-l>{common.film.pause}</span>
    <span class="visually-hidden">{common.film.hint}</span>
  </button>

  <div class="wrap hero__in">
    <div class="hero__plate">
      <p class="hero__story" aria-hidden="true" data-story>
        {STORY.map((s, i) => <span class:list={["hero__chap", { "is-on": i === 0 }]} data-from={s.from}>{s.t}</span>)}
      </p>
      <h1 id="hero-title" class="hero__title"><span class="hero__line">{H.h1[0]}<span class="x">{H.h1[1]}</span>{H.h1[2]}</span></h1>
      <p class="hero__sub">{H.sub}</p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#contact">{common.cta}</a>
        <a class="btn btn--secondary" href={H.cta2.href}>{H.cta2.t}</a>
      </div>
    </div>
  </div>

</section>

<script>
  // film : chargé après une intention (défilement, clic, touche) ou 6 s d'inactivité, puis mis en pause
  // hors écran, onglet caché ou sur demande ; l'affiche WebP couvre l'attente (preload="none").
  const hero = document.querySelector<HTMLElement>(".hero");
  const v = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const btn = document.querySelector<HTMLButtonElement>("[data-hero-pause]");
  const label = btn?.querySelector<HTMLElement>("[data-hero-pause-l]");
  const chaps = [...document.querySelectorAll<HTMLElement>(".hero__chap")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const net = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const saveData = net?.saveData === true;
  // réseau lent : l'affiche reste seule, le film n'arrive que sur intention explicite
  const slow = /(^|-)2g$|(^|-)3g$/.test(net?.effectiveType ?? "");
  if (hero && v && btn && label && !reduce && !saveData) {
    let paused = false, inView = true, shown = 0, loaded = false;
    let timer: number | undefined;
    try { paused = localStorage.getItem("clx-film") === "pause"; } catch { /* stockage indisponible */ }
    // VP9 d'abord (≈ 30 % plus léger), H.264 en repli là où le WebM n'est pas lu (Safari < 14.1)
    const ext = v.canPlayType('video/webm; codecs="vp9"') ? ".webm" : ".mp4";
    const pick = () => {
      if (matchMedia("(max-aspect-ratio: 4/5)").matches) return v.dataset.tall! + ext;
      // plafond 1280 pour un décor : le 1920 n'est servi qu'aux écrans retina, où il apporte encore du détail
      return ((devicePixelRatio || 1) >= 2 ? v.dataset.wideRetina! : v.dataset.wide!) + ext;
    };
    const sync = () => {
      btn.setAttribute("aria-pressed", String(paused));
      label.textContent = (paused ? btn.dataset.lPlay : btn.dataset.lPause) ?? "";
      btn.classList.toggle("is-paused", paused);
      if (!v.src) return;
      if (paused || !inView || document.hidden) v.pause(); else v.play().catch(() => { /* lecture refusée : l'affiche reste */ });
    };
    // les phrases du film suivent l'image
    const story = () => {
      const t = v.currentTime; let i = 0;
      chaps.forEach((c, k) => { if (t >= Number(c.dataset.from)) i = k; });
      if (i !== shown) { chaps[shown].classList.remove("is-on"); chaps[i].classList.add("is-on"); shown = i; }
    };
    const load = () => {
      if (loaded) return;
      loaded = true;
      clearTimeout(timer);
      v.src = pick();
      v.addEventListener("playing", () => { v.classList.add("is-on"); hero.classList.add("has-film"); }, { once: true });
      v.addEventListener("timeupdate", story);
      btn.hidden = false;
      sync();
    };
    // le film part à la première intention (défilement, clic, touche) ou après 6 s de calme
    const intent = () => load();
    for (const type of ["scroll", "pointerdown", "click", "keydown"]) addEventListener(type, intent, { once: true, passive: true });
    if (!slow) timer = window.setTimeout(load, 6000);
    btn.addEventListener("click", () => {
      paused = !paused;
      try { localStorage.setItem("clx-film", paused ? "pause" : "lecture"); } catch { /* stockage indisponible */ }
      sync();
    });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; sync(); }, { threshold: 0.1 }).observe(v);
    document.addEventListener("visibilitychange", sync);
  }
</script>

<style>
  /* plein cadre : la hauteur de l'écran, moins l'en-tête */
  .hero { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: end; min-height: clamp(620px, calc(100svh - 72px), 980px); padding-block: clamp(4rem, 2rem + 5vw, 7rem) clamp(1.5rem, 0.5rem + 3vw, 3.5rem); background: var(--clx-color-encre); }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :is(img, video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity 1200ms var(--clx-easing-out); }
  .hero__video.is-on { opacity: 1; }

  /* la plaque : Encre presque opaque, filet turquoise, comme les titres du film */
  .hero__in { position: relative; }
  .hero__plate { position: relative; max-width: 47rem; padding: clamp(1.5rem, 1rem + 1.8vw, 2.75rem); border-radius: var(--clx-radius-panel); background: rgb(11 34 57 / 0.92); color: var(--clx-text); }
  .hero__story { position: relative; display: grid; min-height: 1.5em; margin-bottom: var(--clx-space-5); padding-top: calc(var(--clx-space-3) + 4px); font: 500 clamp(1rem, 0.94rem + 0.3vw, 1.125rem)/1.3 var(--clx-font-family-text); color: var(--clx-text-muted); }
  .hero__story::before { content: ""; position: absolute; top: 0; left: 0; width: 44px; height: 4px; background: var(--clx-accent); }
  .hero__chap { grid-area: 1 / 1; opacity: 0; transform: translateY(6px); transition: opacity 450ms var(--clx-easing-out), transform 450ms var(--clx-easing-out); }
  .hero__chap.is-on { opacity: 1; transform: none; }
  .hero:not(.has-film) .hero__chap:not(:first-child) { display: none; }

  .hero__title { font-weight: 700; color: var(--clx-text); }
  .hero__line { display: block; font-size: clamp(2.75rem, 1.4rem + 3.9vw, 5rem); line-height: 0.95; letter-spacing: -0.04em; text-wrap: balance; }
  .hero__line .x { color: var(--clx-accent); }
  .hero__sub { display: block; margin-top: var(--clx-space-4); font-weight: 500; font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--clx-text); max-width: 40ch; text-wrap: pretty; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); margin-top: var(--clx-space-6); }
  .hero :global(.btn--secondary) { background: transparent; }


  /* bouton pause (WCAG 2.2.2), en haut à droite, loin du texte */
  .hero__pause { position: absolute; top: var(--clx-space-5); right: max(var(--clx-layout-gutter), env(safe-area-inset-right, 0px)); display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding: 0 0.9rem; border-radius: var(--clx-radius-pill); border: 1px solid var(--clx-border-strong); background: rgb(11 34 57 / 0.8); color: var(--clx-text); font: 600 0.8125rem/1 var(--clx-font-family-text); cursor: pointer; }
  .hero__pause[hidden] { display: none; }
  .hero__pause:hover { border-color: var(--clx-text); }
  .hero__pause:focus-visible { outline: 3px solid var(--clx-focus); outline-offset: 2px; }
  .hero__pause-i { width: 12px; height: 12px; fill: currentColor; }
  .hero__pause .i-play, .hero__pause.is-paused .i-pause { display: none; }
  .hero__pause.is-paused .i-play { display: inline; }

  /* une seule séquence d'ouverture : la plaque se pose, puis la promesse */
  @media (prefers-reduced-motion: no-preference) {
    .hero__plate { animation: plate-in 800ms var(--clx-easing-out) 120ms backwards; }
    .hero__line { animation: line-in 900ms var(--clx-easing-out) 320ms backwards; }
    @keyframes plate-in { from { opacity: 0; transform: translateY(28px); } }
    @keyframes line-in { from { opacity: 0; transform: translateY(14px); } }
  }
  @media (prefers-reduced-motion: reduce) { .hero__video { display: none; } .hero__chap { transition: none; } }
  /* en quittant l'écran, le film descend plus lentement que la page et s'approche à peine : de la profondeur, sans effet */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero { view-timeline: --clx-hero block; }
      .hero__media { animation: clx-hero-sortie linear both; animation-timeline: --clx-hero; animation-range: exit 0% exit 100%; }
      @keyframes clx-hero-sortie { to { transform: translateY(22%) scale(1.06); } }
    }
  }

  /* écrans larges mais bas (portables 1280 × 720) : tout tient dans la hauteur */
  @media (min-width: 900px) and (max-height: 820px) {
    .hero { padding-top: 2.5rem; }
    .hero__plate { padding: 1.75rem 2rem; }
    .hero__line { font-size: clamp(2.5rem, 6.6vh, 4.25rem); }
    .hero__story { margin-bottom: var(--clx-space-4); }
    .hero__sub { margin-top: var(--clx-space-3); }
    .hero__cta { margin-top: var(--clx-space-5); }
  }
  @media (max-width: 599px) {
    /* un seul bouton sur téléphone : le film reste visible, le Forward Deployed Engineering est juste en dessous */
    .hero :global(.hero__cta .btn--secondary) { display: none; }
    .hero__line { font-size: 2.6rem; }
  }
  @media (max-width: 899px) {
    .hero { min-height: clamp(600px, calc(100svh - 64px), 900px); padding-block: 12rem var(--clx-space-4); }
    .hero__plate { padding: var(--clx-space-5); }
    .hero__story { margin-bottom: var(--clx-space-4); }
    .hero__cta { margin-top: var(--clx-space-5); }
    .hero__pause { top: var(--clx-space-4); }
  }
</style>
