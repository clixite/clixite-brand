---
import heroX from "../assets/x/hero.svg?raw";
import geo from "../assets/x/hero.json";
import { SITE } from "../data/site";
import { AUDIENCES, HERO, AVAILABILITY } from "../data/audiences";
// chant : translation de la face vers sa position (0,30 barre à 70°), en unités de la viewBox
const D = 0.3 * 0.2 * 480;
const cdx = (D * Math.cos((70 * Math.PI) / 180)).toFixed(2);
const cdy = (D * Math.sin((70 * Math.PI) / 180)).toFixed(2);
const mail = (subject: string) => SITE.bookingsUrl || `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">Nous résolvons votre <span class="x">x</span>.</span>
        {AUDIENCES.map((a) => <span class="hero__sub" data-aud={a.key}>{HERO[a.key].sub}</span>)}
      </h1>

      <fieldset class="aud" aria-describedby="aud-help">
        <legend class="aud__legend">Vous représentez</legend>
        <div class="aud__opts">
          {AUDIENCES.map((a, i) => (
            <span class="aud__opt">
              <input type="radio" name="aud" id={`aud-${a.key}`} value={a.key} checked={i === 0} />
              <label for={`aud-${a.key}`}><span class="aud__l">{a.label}</span><span class="aud__s">{a.short}</span></label>
            </span>
          ))}
        </div>
        <p id="aud-help" class="visually-hidden">Le contenu de la page s'adapte à votre choix.</p>
      </fieldset>
      <script is:inline>
        // choix d'audience avant le premier affichage : lien ?pour=pme (campagnes, prospection), sinon dernier choix
        (function () {
          var k = null;
          try { k = new URLSearchParams(location.search).get("pour") || localStorage.getItem("clx-aud"); } catch (e) {}
          var el = k && document.getElementById("aud-" + k);
          if (el) { el.checked = true; document.documentElement.dataset.audience = k; }
        })();
      </script>

      {AUDIENCES.map((a) => (
        <div class="hero__body" data-aud={a.key}>
          <p class="lead hero__lead">{HERO[a.key].lead}</p>
          <div class="hero__cta">
            <a class="btn btn--primary" href={mail(HERO[a.key].ctaSubject)}>{HERO[a.key].cta}</a>
            <a class="btn btn--secondary" href={HERO[a.key].second.href}>{HERO[a.key].second.label}</a>
          </div>
        </div>
      ))}
      <p class="hero__facts small"><span class={AVAILABILITY.av ? "hero__avail av" : "hero__avail"}>{AVAILABILITY.text}</span> Clixite, à Wavre depuis 2005.</p>
    </div>
    <div class="hero__art" data-hx style={`--cx:${geo.cx}px; --cy:${geo.cy}px; --cdx:${cdx}px; --cdy:${cdy}px;`}>
      <Fragment set:html={heroX} />
    </div>
  </div>
</section>

<script>
  // Le seul « être vivant » de la page : l'angle entre les deux champs (règle de la charte).
  // Ouverture en CSS (14° vers l'angle de base), puis respiration lente autour de la base, que le choix d'audience accorde :
  // grand groupe 4°, cabinet 5,5°, PME 7°. Le pointeur ouvre l'angle, avec inertie.
  import { AUDIENCES } from "../data/audiences";
  const host = document.querySelector<HTMLElement>("[data-hx]");
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="aud"]')];
  const baseOf = () => AUDIENCES.find((a) => a.key === (radios.find((r) => r.checked)?.value ?? "groupe"))?.angle ?? 4;
  const apply = () => {
    const k = radios.find((r) => r.checked)?.value ?? "groupe";
    document.documentElement.dataset.audience = k;
    try { localStorage.setItem("clx-aud", k); } catch { /* stockage indisponible */ }
    try { const u = new URL(location.href); u.searchParams.set("pour", k); history.replaceState(null, "", u); } catch { /* sans effet */ }
    document.dispatchEvent(new CustomEvent("clx:audience", { detail: k }));
  };
  radios.forEach((r) => r.addEventListener("change", apply));

  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const fine = matchMedia("(pointer: fine)").matches; // écran tactile : le X s'ouvre puis se pose, sans boucle
  if (host && !reduce.matches && fine) {
    let angle = baseOf(), raf = 0, visible = true, pointer = 0, started = 0, shown = -1;
    const t0 = performance.now() + 2400;
    const tick = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      if (now < t0) { raf = requestAnimationFrame(tick); return; }
      if (!started) { started = now; angle = baseOf(); host.classList.add("is-live"); }
      const breath = (1 - Math.cos(((now - started) / 7000) * Math.PI * 2)) * 0.75; // 0 à 1,5°
      const target = Math.min(9.5, baseOf() + breath + pointer * 2);
      angle += (target - angle) * 0.045;
      if (Math.abs(angle - shown) > 0.02) { shown = angle; host.style.setProperty("--hx-a", angle.toFixed(3)); }
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (!raf) raf = requestAnimationFrame(tick); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }, { threshold: 0.05 }).observe(host);
    document.addEventListener("visibilitychange", start);
    window.addEventListener("pointermove", (e) => {
      const r = host.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / Math.max(r.width, 1);
      const dy = (e.clientY - (r.top + r.height / 2)) / Math.max(r.height, 1);
      pointer = Math.max(0, 1 - Math.hypot(dx, dy) / 1.4);
    }, { passive: true });
    start();
  }
</script>

<style>
  .hero { padding-block: clamp(2rem, 0.8rem + 4vw, 5rem) clamp(3rem, 1rem + 5vw, 6rem); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: var(--clx-space-8); align-items: center; }
  .hero__text { max-width: 42rem; }
  .hero__title { font-weight: 700; }
  .hero__line { display: block; font-size: clamp(3rem, 1.3rem + 5.2vw, 6rem); line-height: 0.95; letter-spacing: -0.04em; }
  .hero__sub { display: block; margin-top: var(--clx-space-4); font-weight: 500; font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem); line-height: 1.2; letter-spacing: -0.01em; color: var(--clx-text); max-width: 30ch; }

  /* sélecteur d'audience : trois pilules, l'état choisi passe en Encre */
  .aud { border: 0; padding: 0; margin: var(--clx-space-6) 0 0; min-width: 0; }
  .aud__legend { padding: 0; font-size: 0.9375rem; color: var(--clx-text-muted); margin-bottom: var(--clx-space-2); }
  .aud__opts { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--clx-border-strong); border-radius: var(--clx-radius-pill); background: var(--clx-surface); }
  .aud__opt { position: relative; }
  .aud__opt input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .aud__opt label { display: inline-flex; align-items: center; min-height: 40px; padding: 0 1rem; border-radius: var(--clx-radius-pill); font-weight: 600; font-size: 0.9375rem; color: var(--clx-text); cursor: pointer; transition: background-color var(--clx-duration-quick) var(--clx-easing-out), color var(--clx-duration-quick) var(--clx-easing-out); }
  .aud__opt input:checked + label { background: var(--clx-text); color: var(--clx-bg); }
  .aud__opt input:not(:checked):hover + label { background: var(--clx-bg-alt); }
  .aud__opt input:focus-visible + label { outline: 3px solid var(--clx-focus); outline-offset: 2px; }
  .aud__s { display: none; }

  .hero__lead { margin-top: var(--clx-space-5); max-width: 38rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); margin-top: var(--clx-space-6); }
  .hero__facts { margin-top: var(--clx-space-5); color: var(--clx-text-muted); }
  .hero__avail { color: var(--clx-text); font-weight: 600; }
  .hero__art { color: var(--clx-text-muted); justify-self: end; width: min(100%, 620px); }
  .hero__art :global(svg) { width: 100%; height: auto; overflow: visible; }

  /* ---- X en construction ---- */
  @property --hx-a { syntax: "<number>"; inherits: true; initial-value: 4; }
  .hero__art { --hx-a: 4; transition: --hx-a 900ms var(--clx-easing-out); }
  .hero__art:global(.is-live) { transition: none; }
  :global(:root:has(#aud-pme:checked)) .hero__art { --hx-a: 7; }
  :global(:root:has(#aud-cabinet:checked)) .hero__art { --hx-a: 5.5; }
  .hero__art :global(.hx-guides *) { vector-effect: non-scaling-stroke; }
  .hero__art :global(.hx-guides) { opacity: 0.32; }
  .hero__art :global(.hx-labels) { opacity: 0.7; }
  .hero__art :global(.hx-outline) { opacity: 0; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hero__art :global(.hx-field),
  .hero__art :global(.hx-lens) { transform-box: view-box; transform-origin: var(--cx) var(--cy); }
  .hero__art :global(.hx-field-a) { transform: rotate(calc(var(--hx-a) * -0.5deg)); }
  .hero__art :global(.hx-field-b) { transform: rotate(calc(var(--hx-a) * 0.5deg)); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__art { animation: hx-angle 1300ms var(--clx-easing-out) 1100ms backwards; }
    .hero__art :global(.hx-guides) { animation: hx-guides 2400ms var(--clx-easing-out) backwards; }
    .hero__art :global(.hx-labels) { animation: hx-labels 2400ms var(--clx-easing-out) backwards; }
    .hero__art :global(.hx-outline) { animation: hx-outline 2400ms var(--clx-easing-out) backwards; }
    .hero__art :global(.hx-chant) { animation: hx-chant 700ms var(--clx-easing-out) 1000ms backwards; }
    .hero__art :global(.hx-face) { animation: hx-fade 400ms var(--clx-easing-out) 850ms backwards; }
    .hero__art :global(.hx-field) { animation: hx-fade 700ms var(--clx-easing-out) 1100ms backwards; }
    .hero__art :global(.hx-lens) { animation: hx-lens 500ms var(--clx-easing-out) 1700ms backwards; }
  }
  @keyframes hx-angle { from { --hx-a: 14; } }
  @keyframes hx-guides { 0% { opacity: 0; } 20% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: 0.32; } }
  @keyframes hx-labels { 0%, 12% { opacity: 0; } 32% { opacity: 1; } 75% { opacity: 1; } 100% { opacity: 0.7; } }
  @keyframes hx-outline { 0% { opacity: 1; stroke-dashoffset: 1; } 46% { opacity: 1; stroke-dashoffset: 0; } 66% { opacity: 1; stroke-dashoffset: 0; } 92%, 100% { opacity: 0; stroke-dashoffset: 0; } }
  @keyframes hx-chant { from { opacity: 0; transform: translate(calc(var(--cdx) * -1), calc(var(--cdy) * -1)); } to { opacity: 1; transform: none; } }
  @keyframes hx-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hx-lens { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero__art { transition: none; } }

  @media (max-width: 599px) { .hero__art :global(.hx-labels) { display: none; } .aud__l { display: none; } .aud__s { display: inline; } }
  @media (max-width: 899px) {
    .hero { padding-top: var(--clx-space-5); }
    .hero__in { grid-template-columns: 1fr; gap: var(--clx-space-5); }
    .hero__art { order: -1; justify-self: center; width: min(42vw, 300px); }
    .hero__sub { font-size: 1.1875rem; }
  }
  @media (max-width: 899px) and (max-height: 760px) { .hero__art { width: min(44vw, 240px); } }
</style>
