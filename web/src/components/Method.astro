---
import e1 from "../assets/x/etape-1.svg?raw";
import e2 from "../assets/x/etape-2.svg?raw";
import e3 from "../assets/x/etape-3.svg?raw";
import e4 from "../assets/x/etape-4.svg?raw";
const steps = [
  { svg: e1, t: "Relever", d: "Cartographie de vos systèmes, de vos flux, de vos contrats et de vos risques. On mesure avant de dessiner.", out: "Diagnostic" },
  { svg: e2, t: "Concevoir", d: "L'architecture cible et le chemin pour y aller, en options chiffrées. Ce qu'on garde, ce qu'on remplace, ce qu'on arrête.", out: "Cible et feuille de route" },
  { svg: e3, t: "Construire", d: "Intégrations, données, automatisations et IA, livrées par incréments courts que vos équipes testent en conditions réelles.", out: "Incréments en production" },
  { svg: e4, t: "Mettre en service", d: "Déploiement, adoption et transfert. Nous partons quand vos équipes tiennent la solution seules.", out: "Solution exploitée et documentée" },
];
---
<section id="methode" class="section method" aria-labelledby="method-title">
  <div class="wrap">
    <div class="method__head">
      <h2 id="method-title" class="h2">Du relevé à la mise en service.</h2>
      <p class="lead">Quatre étapes, chacune avec un livrable que vous gardez, même si vous arrêtez là. Vous décidez de la suivante sur pièces.</p>
    </div>
    <ol role="list" class="method__list">
      {steps.map((s, i) => (
        <li class="method__step" style={`--i:${i}`}>
          <div class="method__art" set:html={s.svg} />
          <h3 class="h3">{s.t}</h3>
          <p class="muted">{s.d}</p>
          <p class="method__meta small"><span>Livrable</span> <span class="method__out">{s.out}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--clx-space-7); align-items: end; }
  .method__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--clx-space-6); margin-top: var(--clx-space-8); counter-reset: none; }
  .method__art { color: var(--clx-text); width: min(100%, 220px); aspect-ratio: 1; margin-bottom: var(--clx-space-5); }
  .method__art :global(svg) { width: 100%; height: 100%; }
  .method__step { display: flex; flex-direction: column; }
  .method__step p.muted { margin-top: var(--clx-space-3); margin-bottom: var(--clx-space-4); }
  .method__meta { margin-top: auto !important; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding-top: var(--clx-space-3); border-top: 1px solid var(--clx-border); font-weight: 600; }
  .method__out { font-weight: 500; color: var(--clx-text-muted); }
  /* le X se construit au défilement : une cote turquoise court sur les filets « Livrable », chaque dessin passe du relevé
     au plein, puis le chant du X tombe à sa place. Repli (mouvement réduit, sans prise en charge) : le dessin, inchangé. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .method__list { view-timeline: --clx-methode block; }
      .method__meta { position: relative; }
      .method__meta::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--clx-accent); transform-origin: 0 50%; animation: clx-cote var(--clx-easing-out) both; animation-timeline: --clx-methode; animation-range: cover calc(14% + var(--i) * 8%) cover calc(22% + var(--i) * 8%); }
      .method__art { animation: clx-pose linear both; animation-timeline: --clx-methode; animation-range: cover calc(10% + var(--i) * 8%) cover calc(22% + var(--i) * 8%); }
      .method__step:last-child .method__art :global(svg > path:first-of-type) { animation: clx-chant var(--clx-easing-out) both; animation-timeline: --clx-methode; animation-range: cover 44% cover 52%; }
      @media (max-width: 599px) {
        .method__step { view-timeline: --clx-etape block; }
        .method__meta::before, .method__art { animation-timeline: --clx-etape; animation-range: entry 80% cover 45%; }
        .method__step:last-child .method__art :global(svg > path:first-of-type) { animation-timeline: --clx-etape; animation-range: cover 40% cover 52%; }
      }
    }
  }
  @keyframes clx-pose { from { opacity: 0.2; } }
  @keyframes clx-chant { from { opacity: 0; transform: translate(-4.1px, -11.3px); } }
  @media (max-width: 1099px) { .method__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--clx-space-8); } }
  @media (max-width: 899px) { .method__head { grid-template-columns: 1fr; gap: var(--clx-space-4); } }
  @media (max-width: 599px) {
    .method__list { grid-template-columns: 1fr; gap: var(--clx-space-7); margin-top: var(--clx-space-7); }
    .method__step { display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: var(--clx-space-5); align-items: start; }
    .method__art { grid-row: span 3; width: 96px; margin: 0; }
  }
</style>
