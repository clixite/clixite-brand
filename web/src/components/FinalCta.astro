---
import { SITE, bookingHref } from "../data/site";
import CopyMail from "./CopyMail.astro";
---
<section id="contact" class="section final" data-theme="encre" aria-labelledby="final-title">
  <div class="wrap final__in">
    <h2 id="final-title" class="final__title">Quel est votre <span class="x">x</span>&nbsp;?</h2>
    <div class="final__body">
      <p class="lead">Trente minutes suffisent pour le nommer. Vous repartez avec une première piste, même si nous ne travaillons pas ensemble.</p>
      <div class="final__cta">
        <a class="btn btn--primary" href={bookingHref()}>Demander un échange de 30 min</a>
      </div>
      <p class="final__mail">Ou écrivez directement à <CopyMail /></p>
      <p class="small muted final__addr">{SITE.legalName}, {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}. Rendez-vous à Wavre, chez vous ou en visio.</p>
    </div>
  </div>
</section>

<style>
  .final { border-bottom: 1px solid var(--clx-border); }
  .final__in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: end; }
  .final__title { font-size: var(--clx-type-display-font-size); line-height: var(--clx-type-display-line-height); letter-spacing: var(--clx-type-display-letter-spacing); font-weight: 700; color: var(--clx-text); }
  .final__title .x { color: var(--clx-accent); }
  .final__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); margin-top: var(--clx-space-6); }
  .final__mail { margin-top: var(--clx-space-4); color: var(--clx-text-muted); }
  .final__addr { margin-top: var(--clx-space-5); }
  .final :global(.btn--secondary) { color: var(--clx-text); }
  @media (max-width: 899px) { .final__in { grid-template-columns: 1fr; gap: var(--clx-space-5); } }
</style>
