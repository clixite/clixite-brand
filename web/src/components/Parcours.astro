---
// Le parcours en X : deux trajectoires qui se croisent en 2026.
// Barre descendante : entreprendre (2005 à 2024). Barre montante : les grands comptes (2018 à 2026).
// Après le croisement, chaque expérience passe de l'autre côté : la vitesse de l'entrepreneur vers les grands groupes,
// la rigueur des grands groupes vers les PME. Schéma (pas un graphique à l'échelle) : chaque jalon porte son année.
interface Step { yr: string; t: string; s: string; av?: boolean }
const entreprendre: Step[] = [
  { yr: "2005", t: "Fonde Clixite, agence de communication", s: "Fonde Clixite", av: true },
  { yr: "2011", t: "Cède l'agence Clixite Communication ; la société Clixite SRL continue", s: "Cède Clixite Communication", av: true },
  { yr: "2015", t: "Clixite passe de la communication à l'architecture", s: "Clixite passe à l’architecture" },
  { yr: "2017", t: "Cède Twin Square Catering, traiteur aérien à Brussels Airport", s: "Cède Twin Square Catering", av: true },
  { yr: "2024", t: "Construit ses logiciels : conformité NIS2, risques tiers par agents IA", s: "Construit ses logiciels IA", av: true },
];
const grandsComptes: Step[] = [
  { yr: "2018", t: "Proximus, Senior Program Manager du domaine TV", s: "Proximus, Program Manager TV" },
  { yr: "2022", t: "Proximus, Procurement Lead, environ 800 M€", s: "Proximus, Procurement Lead", av: true },
  { yr: "2025", t: "P&V Assurances et Vivium, Head of Procurement par intérim", s: "P&V, Head of Procurement", av: true },
  { yr: "2025", t: "KBC, Expert Procurement et TPRM Advisor, 18 mois (2025 à 2026)", s: "KBC, Procurement et TPRM", av: true },
];
// géométrie : X symétrique dans une viewBox 1000 × 560, centre (500, 280)
const W = 1000, H = 560, P = 40, C = { x: 500, y: 280 };
const A0 = { x: P, y: P }, A1 = { x: W - P, y: H - P };      // entreprendre : haut gauche vers bas droite
const B0 = { x: P, y: H - P }, B1 = { x: W - P, y: P };      // grands comptes : bas gauche vers haut droite
const lerp = (p: { x: number; y: number }, q: { x: number; y: number }, t: number) => ({ x: p.x + (q.x - p.x) * t, y: p.y + (q.y - p.y) * t });
const ts = [0.05, 0.15, 0.25, 0.35];
const tsA = [0.04, 0.125, 0.21, 0.295, 0.38];   // cinq jalons côté entreprendre
const ptsA = entreprendre.map((s, i) => ({ ...s, ...lerp(A0, A1, tsA[i]) }));
const ptsB = grandsComptes.map((s, i) => ({ ...s, ...lerp(B0, B1, ts[i]) }));
const tick = (x: number, y: number, dir: 1 | -1) => {
  // petit trait perpendiculaire à la barre (pas de points reliés)
  const n = { x: 0.6, y: 0.8 * dir };
  return `M${(x - n.x * 9).toFixed(1)} ${(y + n.y * 9).toFixed(1)}L${(x + n.x * 9).toFixed(1)} ${(y - n.y * 9).toFixed(1)}`;
};
---
<figure class="parcours" aria-labelledby="parcours-cap">
  <svg class="parcours__svg" viewBox={`0 -40 ${W} ${H + 80}`} aria-hidden="true" focusable="false">
    <line class="p-bar" x1={A0.x} y1={A0.y} x2={C.x} y2={C.y} />
    <line class="p-bar" x1={B0.x} y1={B0.y} x2={C.x} y2={C.y} />
    <line class="p-bar p-bar--next" x1={C.x} y1={C.y} x2={A1.x} y2={A1.y} />
    <line class="p-bar p-bar--next" x1={C.x} y1={C.y} x2={B1.x} y2={B1.y} />
    {ptsA.map((p) => <path class="p-tick" d={tick(p.x, p.y, -1)} />)}
    {ptsB.map((p) => <path class="p-tick" d={tick(p.x, p.y, 1)} />)}
    {ptsA.map((p) => (
      <text class="p-label" x={p.x + 18} y={p.y - 30}><tspan class="p-year" x={p.x + 18}>{p.yr}</tspan><tspan x={p.x + 18} dy="20">{p.s}</tspan></text>
    ))}
    {ptsB.map((p) => (
      <text class="p-label" x={p.x + 18} y={p.y + 30}><tspan class="p-year" x={p.x + 18}>{p.yr}</tspan><tspan x={p.x + 18} dy="20">{p.s}</tspan></text>
    ))}
    <path class="p-lens" d={`M${C.x} ${C.y - 16}L${C.x + 12} ${C.y}L${C.x} ${C.y + 16}L${C.x - 12} ${C.y}Z`} />
    <text class="p-now" x={C.x + 34} y={C.y + 6}><tspan class="p-year" x={C.x + 34} dy="-22">2026</tspan><tspan x={C.x + 34} dy="22">Clixite : les deux à la fois</tspan></text>
    <text class="p-end" x={A1.x} y={A1.y + 12} text-anchor="end"><tspan x={A1.x}>Pour les grands groupes :</tspan><tspan x={A1.x} dy="20">la vitesse d’un entrepreneur</tspan></text>
    <text class="p-end" x={B1.x} y={B1.y - 28} text-anchor="end"><tspan x={B1.x}>Pour les PME :</tspan><tspan x={B1.x} dy="20">la rigueur d’un grand groupe</tspan></text>
  </svg>
  <div class="parcours__list">
    <div>
      <h3 class="h3">Entreprendre</h3>
      <ol role="list">{entreprendre.map((s) => <li class={s.av ? "av" : undefined}><span class="data">{s.yr}</span> {s.t}</li>)}</ol>
    </div>
    <div>
      <h3 class="h3">Les grands comptes</h3>
      <ol role="list">{grandsComptes.map((s) => <li class={s.av ? "av" : undefined}><span class="data">{s.yr}</span> {s.t}</li>)}</ol>
    </div>
  </div>
  <figcaption id="parcours-cap" class="parcours__cap">
    Deux trajectoires qui se croisent en 2026. L'esprit d'entrepreneur dans les grands groupes, la rigueur des grands groupes dans les PME.
  </figcaption>
</figure>

<style>
  .parcours { margin: 0; display: grid; gap: var(--clx-space-5); }
  .parcours__svg { width: 100%; height: auto; overflow: visible; }
  .p-bar { stroke: var(--clx-text); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .p-bar--next { stroke: var(--clx-text-muted); stroke-dasharray: 6 8; }
  .p-tick { stroke: var(--clx-text); stroke-width: 2; vector-effect: non-scaling-stroke; fill: none; }
  .p-lens { fill: var(--clx-accent); }
  .p-label, .p-now, .p-end { font-family: var(--clx-font-family-text); font-size: 15px; fill: var(--clx-text-muted); }
  .p-now { fill: var(--clx-text); font-weight: 600; }
  .p-end { fill: var(--clx-text); font-weight: 500; }
  .p-year { font-family: var(--clx-font-family-display); font-weight: 700; font-size: 18px; fill: var(--clx-text); }
  .parcours__list { display: none; }
  .parcours__cap { font-family: var(--clx-font-family-voice); font-style: italic; font-weight: 500; font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem); line-height: 1.3; max-width: 46ch; color: var(--clx-text); }
  /* sous 900 px, le schéma laisse place à deux listes lisibles ; au-dessus, les listes restent pour les lecteurs d'écran */
  @media (min-width: 900px) { .parcours__list { display: block; position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  @media (max-width: 899px) {
    .parcours__svg { display: none; }
    .parcours__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--clx-space-6); }
    .parcours__list ol { margin: var(--clx-space-3) 0 0; padding: 0; display: grid; gap: var(--clx-space-3); }
    .parcours__list li { color: var(--clx-text-muted); }
    .parcours__list .data { display: block; color: var(--clx-text); font-size: 0.9375rem; }
  }
  @media (max-width: 559px) { .parcours__list { grid-template-columns: 1fr; } }
</style>
