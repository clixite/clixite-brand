---
// Le solveur : trois questions, une recommandation qui se compose en direct, puis une demande préremplie.
// Règles simples (pas d'IA) : la recommandation vient de src/data/audiences.ts, rien n'est envoyé sans clic.
import { AUDIENCES, SOLVER, URGENCY } from "../data/audiences";
import { SITE } from "../data/site";
const first = (k: keyof typeof SOLVER) => SOLVER[k].x[0].rec;
---
<section id="solveur" class="section solver" data-theme="encre" aria-labelledby="solver-title">
  <div class="wrap">
    <div class="solver__head">
      <h2 id="solver-title" class="h2">Trois questions, une première piste.</h2>
      <p class="lead">Répondez : la recommandation se compose en direct, avec les premières actions, le livrable et la durée. Rien n'est envoyé tant que vous ne le demandez pas.</p>
    </div>

    <div class="solver__in">
      <form class="solver__form" data-solver novalidate aria-label="Questions du solveur">
        {AUDIENCES.map((a) => (
          <fieldset class="q" data-aud={a.key}>
            <legend class="q__legend">Votre enjeu</legend>
            <div class="q__opts">
              {SOLVER[a.key].x.map((x, i) => (
                <label class="chip"><input type="radio" name={`sx-${a.key}`} value={x.id} checked={i === 0} /><span>{x.label}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        <fieldset class="q">
          <legend class="q__legend">Échéance</legend>
          <div class="q__opts">
            {URGENCY.map((u, i) => <label class="chip"><input type="radio" name="su" value={u} checked={i === 1} /><span>{u}</span></label>)}
          </div>
        </fieldset>
        {AUDIENCES.map((a) => (
          <fieldset class="q" data-aud={a.key}>
            <legend class="q__legend">Format souhaité</legend>
            <div class="q__opts">
              {SOLVER[a.key].formats.map((f, i) => <label class="chip"><input type="radio" name={`sf-${a.key}`} value={f} checked={i === 0} /><span>{f}</span></label>)}
            </div>
          </fieldset>
        ))}
        <p class="solver__aud small">Recommandation pour <span data-solver-aud>{AUDIENCES[0].label}</span>. <a href="#hero-title">Changer</a></p>
      </form>

      <article class="solver__out" aria-live="polite" aria-atomic="true" data-solver-out>
        <p class="solver__kicker small">Notre recommandation</p>
        <h3 class="solver__title" data-r="title">{first("groupe").title}</h3>
        <p class="solver__label small">Ce que nous ferions en premier</p>
        <ol class="solver__steps" data-r="first">{first("groupe").first.map((f) => <li>{f}</li>)}</ol>
        <dl class="solver__facts">
          <div><dt>Livrable</dt><dd data-r="deliverable">{first("groupe").deliverable}</dd></div>
          <div><dt>Durée indicative</dt><dd data-r="duration" class="av">{first("groupe").duration}</dd></div>
          <div><dt>Preuve proche</dt><dd data-r="proof" class="av">{first("groupe").proof}</dd></div>
        </dl>
        <a class="btn btn--primary solver__cta" data-r="cta" href={`mailto:${SITE.email}`}>Envoyer cette demande</a>
        <p class="small solver__note">Le bouton ouvre votre messagerie avec vos réponses déjà rédigées. <span class="av">Réponse sous un jour ouvrable.</span></p>
      </article>
    </div>
  </div>
</section>

<script>
  import { SOLVER, AUDIENCES, type AudKey } from "../data/audiences";
  import { SITE } from "../data/site";
  const form = document.querySelector<HTMLFormElement>("[data-solver]");
  const out = document.querySelector<HTMLElement>("[data-solver-out]");
  if (form && out) {
    form.addEventListener("submit", (e) => e.preventDefault());
    const aud = (): AudKey => ((document.querySelector<HTMLInputElement>('input[name="aud"]:checked')?.value ?? document.documentElement.dataset.audience ?? "groupe") as AudKey);
    const val = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "";
    const set = (k: string, v: string) => { const el = out.querySelector<HTMLElement>(`[data-r="${k}"]`); if (el) el.textContent = v; };
    const render = () => {
      const k = aud(); const data = SOLVER[k];
      const x = data.x.find((i) => i.id === val(`sx-${k}`)) ?? data.x[0];
      const urgency = val("su"); const format = val(`sf-${k}`);
      const label = AUDIENCES.find((a) => a.key === k)?.label ?? "";
      set("title", x.rec.title); set("deliverable", x.rec.deliverable); set("duration", x.rec.duration); set("proof", x.rec.proof);
      const ol = out.querySelector('[data-r="first"]'); if (ol) ol.replaceChildren(...x.rec.first.map((f) => { const li = document.createElement("li"); li.textContent = f; return li; }));
      const audEl = form.querySelector("[data-solver-aud]"); if (audEl) audEl.textContent = label;
      const subject = `${x.label} : ${x.rec.title}`;
      const body = `Bonjour Nicolas,\n\nJe représente ${label}.\nNotre enjeu : ${x.label}.\nÉchéance : ${urgency}.\nFormat souhaité : ${format}.\n\nPiste proposée par le site : ${x.rec.title}.\n\nContexte en deux phrases :\n\n\nMes disponibilités pour un échange :\n`;
      const cta = out.querySelector<HTMLAnchorElement>('[data-r="cta"]');
      if (cta) cta.href = SITE.bookingsUrl || `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      out.classList.remove("is-new"); void out.offsetWidth; out.classList.add("is-new");
    };
    form.addEventListener("change", render);
    document.addEventListener("clx:audience", render);
    render();
  }
</script>

<style>
  .solver__head { display: grid; gap: var(--clx-space-5); max-width: 52rem; }
  .solver__head .lead { max-width: 52ch; }
  .solver__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-7); margin-top: var(--clx-space-8); align-items: start; }
  .solver__form { display: grid; gap: var(--clx-space-6); }
  .q { border: 0; padding: 0; margin: 0; min-width: 0; }
  .q__legend { padding: 0; font-family: var(--clx-font-family-display); font-weight: 500; font-size: 1.125rem; margin-bottom: var(--clx-space-3); color: var(--clx-text); }
  .q__opts { display: flex; flex-wrap: wrap; gap: var(--clx-space-2); }
  .chip { position: relative; display: inline-flex; }
  .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.125rem; border-radius: var(--clx-radius-pill); border: 1px solid var(--clx-border-strong); color: var(--clx-text); font-weight: 500; font-size: 0.9375rem; transition: background-color var(--clx-duration-quick) var(--clx-easing-out), border-color var(--clx-duration-quick) var(--clx-easing-out), color var(--clx-duration-quick) var(--clx-easing-out); cursor: pointer; }
  .chip input:hover + span { border-color: var(--clx-text); }
  .chip input:checked + span { background: var(--clx-accent); border-color: var(--clx-accent); color: var(--clx-on-accent); font-weight: 600; }
  .chip input:focus-visible + span { outline: 3px solid var(--clx-focus); outline-offset: 2px; }
  .solver__aud { color: var(--clx-text-muted); }
  .solver__aud a { color: var(--clx-link); }

  .solver__out { position: sticky; top: 96px; display: grid; gap: var(--clx-space-4); padding: var(--clx-space-6); border-radius: var(--clx-radius-panel); background: var(--clx-color-papier); color: var(--clx-color-encre); }
  .solver__out :is(h3, dt) { color: var(--clx-color-encre); }
  .solver__kicker { color: var(--clx-color-turquoise-600); font-weight: 600; }
  .solver__title { font-family: var(--clx-font-family-display); font-weight: 700; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .solver__label { font-weight: 600; margin-top: var(--clx-space-2); }
  .solver__steps { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.4rem; color: var(--clx-color-encre); }
  .solver__steps li::marker { color: var(--clx-color-turquoise-600); font-weight: 600; }
  .solver__facts { display: grid; gap: var(--clx-space-3); margin: var(--clx-space-2) 0 0; padding-top: var(--clx-space-4); border-top: 1px solid var(--clx-color-brume); }
  .solver__facts div { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: var(--clx-space-3); }
  .solver__facts dt { font-weight: 600; font-size: 0.9375rem; }
  .solver__facts dd { color: var(--clx-color-ardoise); }
  :global(.review) .solver__out .av { background: var(--clx-color-signal-100); outline-color: var(--clx-color-signal-100); }
  .solver__cta { justify-self: start; margin-top: var(--clx-space-2); }
  .solver__note { color: var(--clx-color-ardoise); }
  @media (prefers-reduced-motion: no-preference) {
    .solver__out.is-new :is([data-r="title"], [data-r="first"]) { animation: solver-in 450ms var(--clx-easing-out); }
    @keyframes solver-in { from { opacity: 0.25; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 999px) {
    .solver__in { grid-template-columns: 1fr; }
    .solver__out { position: static; }
  }
  @media (max-width: 479px) { .solver__facts div { grid-template-columns: 1fr; gap: 2px; } }
</style>
