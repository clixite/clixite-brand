---
// Ce qu'en disent les clients. Rien ne s'affiche tant que src/data/quotes.ts est vide.
import { QUOTES } from "../data/quotes";
---
{QUOTES.length > 0 && (
  <section class="section quotes" aria-labelledby="quotes-title">
    <div class="wrap">
      <h2 id="quotes-title" class="h2">Ce qu'en disent nos clients.</h2>
      <ul role="list" class="quotes__list">
        {QUOTES.map((x) => (
          <li data-aud={x.aud.join(" ")}>
            <figure>
              <blockquote><p>« {x.q} »</p></blockquote>
              <figcaption><span class="quotes__who">{x.who}</span>, {x.role}, {x.org}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .quotes__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--clx-space-7); margin-top: var(--clx-space-8); }
  .quotes blockquote p { font-family: var(--clx-font-family-voice); font-style: italic; font-weight: 500; font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem); line-height: 1.3; text-wrap: pretty; }
  .quotes figcaption { margin-top: var(--clx-space-4); color: var(--clx-text-muted); }
  .quotes__who { color: var(--clx-text); font-weight: 600; }
</style>
