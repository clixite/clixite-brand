---
const figures = [
  { n: "≈ 800 M€", d: "d'achats dans le périmètre couvert comme Procurement Lead chez Proximus, de 2022 à 2024.", src: "Parcours du fondateur", av: true },
  { n: "2005", d: "Clixite SRL voit le jour à Wavre. Plus de vingt ans de projets, de la communication à l'architecture.", src: "Clixite" },
  { n: "7", d: "certifications professionnelles : PMP, PRINCE2, AgilePM, SAFe, Scrum, ITIL v3 et ADKAR.", src: "Nicolas Simon" },
  { n: "3", d: "langues de travail, sans traduction mot à mot : français, anglais et néerlandais.", src: "Clixite" },
];
const cases = [
  { c: "KBC", d: "Politique achats à trois niveaux (L1, L2, L3) pour la direction des achats.", g: "Mission Clixite" },
  { c: "Groupe P&V", d: "Direction des achats par intérim, P&V Assurances et Vivium, en 2025.", g: "Mission Clixite" },
  { c: "Tero et Design Plus", d: "Architecture de croissance : sites, outils métier, données et visibilité dans les moteurs IA.", g: "Missions Clixite" },
];
---
<section class="section proofs" aria-labelledby="proofs-title">
  <div class="wrap">
    <h2 id="proofs-title" class="h2 proofs__title">Des chiffres, avec leur contexte.</h2>
    <dl class="proofs__figs">
      {figures.map((f) => (
        <div class="proofs__fig">
          <dt class="proofs__n">{f.n}</dt>
          <dd class={f.av ? "av" : undefined}>{f.d}<span class="proofs__src small">{f.src}</span></dd>
        </div>
      ))}
    </dl>
    <ul role="list" class="proofs__cases">
      {cases.map((k) => (
        <li class="av">
          <p class="proofs__client">{k.c}</p>
          <p>{k.d}</p>
          <p class="small muted">{k.g}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proofs__title { max-width: 18ch; }
  .proofs__figs { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); gap: var(--clx-space-7); margin-top: var(--clx-space-8); }
  .proofs__n { font-family: var(--clx-font-family-voice); font-style: italic; font-weight: 500; font-size: var(--clx-type-figure-font-size); line-height: var(--clx-type-figure-line-height); letter-spacing: var(--clx-type-figure-letter-spacing); color: var(--clx-link); white-space: nowrap; font-variant-numeric: lining-nums; }
  .proofs__fig dd { margin-top: var(--clx-space-4); color: var(--clx-text-muted); max-width: 30ch; }
  .proofs__src { display: block; margin-top: var(--clx-space-3); color: var(--clx-text); font-weight: 500; }
  .proofs__cases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-6); margin-top: var(--clx-space-9); padding-top: var(--clx-space-7); border-top: 1px solid var(--clx-border); }
  .proofs__cases li { display: grid; gap: var(--clx-space-2); align-content: start; }
  .proofs__client { font-family: var(--clx-font-family-display); font-weight: 500; font-size: 1.25rem; }
  @media (max-width: 1099px) { .proofs__figs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .proofs__cases { grid-template-columns: 1fr; } }
  @media (max-width: 479px) { .proofs__figs { grid-template-columns: 1fr; gap: var(--clx-space-6); } }
</style>
