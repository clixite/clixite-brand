---
import { SITE } from "../data/site";
import Parcours from "./Parcours.astro";
const commitments = [
  { t: "Dans vos équipes, pas à côté.", d: "Nous travaillons avec vos équipes, dans vos outils et à votre rythme. Les décisions se prennent là où le travail se fait." },
  { t: "En production, pas en PowerPoint.", d: "Chaque mission se mesure à ce qui tourne : une intégration, un processus, un agent IA, un tableau de bord utilisé le lundi matin." },
  { t: "Outillé par l'IA, sous votre contrôle.", d: "Des outils d'IA récents, dont Claude, utilisés seulement avec votre accord, sur vos environnements et selon vos règles de sécurité. Vous gardez le code, les accès et la documentation." },
];
---
<section class="section profile" data-theme="encre" aria-labelledby="profile-title">
  <div class="wrap">
    <div class="profile__head">
      <h2 id="profile-title" class="h2">L'architecte de vos systèmes, jusqu'à la mise en service.</h2>
      <p class="lead profile__lead">
        Enterprise &amp; Solution Architect pour concevoir, Forward Deployed Engineer pour mettre en œuvre : un architecte des systèmes d'information et des organisations, pas du bâtiment.
        Nous nous installons dans vos équipes et restons jusqu'à la mise en service, que vous soyez une PME de vingt personnes ou un groupe de vingt mille.
      </p>
    </div>
    <ul role="list" class="profile__list">
      {commitments.map((c) => (
        <li>
          <h3 class="h3">{c.t}</h3>
          <p>{c.d}</p>
        </li>
      ))}
    </ul>
    <div class="profile__parcours">
      <h3 class="profile__ptitle">Un parcours en X.</h3>
      <Parcours />
    </div>
    <figure class="profile__founder">
      <blockquote>
        <p class="av">« Mon métier, c'est de trouver l'inconnue de l'équation, puis de rester jusqu'à ce qu'elle soit résolue en production. »</p>
      </blockquote>
      <figcaption>
        <span><span class="profile__name">{SITE.founder.name}</span>, fondateur de Clixite.</span>
        <span class="av">Plus de quinze ans dans la banque, l'assurance, les télécoms et les médias. Entrepreneur depuis 2005.</span>
        <span class="profile__certs">{SITE.founder.certifications.join(", ")}</span>
        <a href={SITE.linkedin} rel="me noopener" class="link-more">Profil LinkedIn</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .profile__head { max-width: 56rem; }
  .profile__head .h2 { max-width: 22ch; text-wrap: balance; }
  .profile__lead { margin-top: var(--clx-space-5); max-width: 52ch; }
  .profile__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-7); margin-top: var(--clx-space-9); }
  .profile__list p { margin-top: var(--clx-space-3); color: var(--clx-text-muted); }
  .profile__parcours { margin-top: var(--clx-space-9); display: grid; gap: var(--clx-space-6); }
  .profile__ptitle { font-family: var(--clx-font-family-display); font-weight: 700; font-size: var(--clx-type-h2-font-size); line-height: 1.05; letter-spacing: -0.025em; }
  .profile__founder { margin-top: var(--clx-space-9); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--clx-space-7); align-items: end; padding-top: var(--clx-space-8); border-top: 1px solid var(--clx-border); }
  .profile__founder blockquote p { font-family: var(--clx-font-family-voice); font-style: italic; font-weight: 500; font-size: var(--clx-type-quote-font-size); line-height: var(--clx-type-quote-line-height); letter-spacing: var(--clx-type-quote-letter-spacing); text-wrap: balance; }
  .profile__founder figcaption { display: grid; gap: 0.5rem; color: var(--clx-text-muted); }
  .profile__name { color: var(--clx-text); font-weight: 600; }
  .profile__certs { color: var(--clx-text-muted); }
  .profile a { color: var(--clx-link); }
  @media (max-width: 899px) {
    .profile__list { grid-template-columns: 1fr; gap: var(--clx-space-6); margin-top: var(--clx-space-7); }
    .profile__founder { grid-template-columns: 1fr; margin-top: var(--clx-space-7); }
  }
</style>
