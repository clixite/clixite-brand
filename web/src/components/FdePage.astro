---
// Page pilier Forward Deployed Engineering (français et anglais, même structure). Contenu : src/data/fde.ts.
import Crumbs from "./Crumbs.astro";
import Photo from "./Photo.astro";
import Formats from "./Formats.astro";
import Faq from "./Faq.astro";
import FinalCta from "./FinalCta.astro";
import e1 from "../assets/x/etape-1.svg?raw";
import e2 from "../assets/x/etape-2.svg?raw";
import e3 from "../assets/x/etape-3.svg?raw";
import e4 from "../assets/x/etape-4.svg?raw";
import { FDE } from "../data/fde";
import { METIERS } from "../data/expertises";
interface Props { lang: "fr" | "en" }
const { lang } = Astro.props;
const C = FDE[lang];
const arts = [e1, e2, e3, e4];
const others = METIERS.filter((m) => m.slug !== "forward-deployed-engineering");
const anchor = lang === "en" ? "how" : "methode-fde";
---
<Crumbs items={C.crumbs} label={lang === "en" ? "Breadcrumb" : "Fil d'Ariane"} />

<section class="fp-head" aria-labelledby="fp-title">
  <div class="wrap fp-head__in">
    <h1 id="fp-title" class="fp-head__title"><span class="fp-head__term">{C.h1[0]}</span><span class="fp-head__claim">{C.h1[1]}</span></h1>
    <div class="fp-head__side">
      <p class="fp-head__chapo">{C.chapo}</p>
      <div class="fp-head__cta">
        <a class="btn btn--primary" href="#contact">{C.cta}</a>
        <a class="btn btn--secondary" href={`#${anchor}`}>{C.cta2}</a>
      </div>
      <p class="small muted"><time datetime="2026-10-26">{C.updated}</time></p>
    </div>
  </div>
  <div class="wrap">
    <div class="ph ph--parallax fp-head__ph"><Photo name="ingenieurs-169" small="ingenieurs-45" eager sizes="(min-width: 1360px) 1280px, 100vw" alt={lang === "en" ? "Three engineers leaning over a laptop on a test bench in a workshop." : undefined} /></div>
  </div>
</section>

<section class="section fp-what" aria-labelledby="fp-what">
  <div class="wrap fp-cols">
    <h2 id="fp-what" class="h2">{C.what.h}</h2>
    <div class="fp-prose">
      {C.what.p.map((p) => <p>{p}</p>)}
      <h3 class="h3 fp-sub">{C.origin.h}</h3>
      <p>{C.origin.p}</p>
      <p class="small muted fp-src">{C.origin.srcLabel}{lang === "fr" ? " :" : ":"} {C.origin.src.map((s, i) => <>{i > 0 && ", "}<a href={s.href} rel="noopener">{s.t}</a></>)}.</p>
    </div>
  </div>
</section>

<section class="section fp-when band-alt" aria-labelledby="fp-when">
  <div class="wrap fp-cols">
    <h2 id="fp-when" class="h2">{C.when.h}</h2>
    <ul class="fp-when__list">{C.when.items.map((x) => <li>{x}</li>)}</ul>
  </div>
</section>

<section id={anchor} class="section fp-method" aria-labelledby="fp-method">
  <div class="wrap">
    <div class="fp-method__head">
      <h2 id="fp-method" class="h2">{C.method.h}</h2>
      <p class="lead">{C.method.lead}</p>
    </div>
    <ol role="list" class="fp-steps">
      {C.method.steps.map((s, i) => (
        <li class="fp-step" style={`--i:${i}`}>
          <div class="fp-step__art" set:html={arts[i]} />
          <h3 class="h3">{s.t}</h3>
          <p class="muted">{s.d}</p>
          <p class="fp-step__out small"><span>{C.method.outLabel}</span> <span>{s.out}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section fp-compare" data-theme="encre" aria-labelledby="fp-compare">
  <div class="wrap">
    <h2 id="fp-compare" class="h2">{C.compare.h}</h2>
    <div class="fp-table">
      <table>
        <thead><tr>{C.compare.cols.map((c, i) => i === 0 ? <td /> : <th scope="col">{c}</th>)}</tr></thead>
        <tbody>
          {C.compare.rows.map(([n, ...cells], r) => (
            <tr class={r === 0 ? "is-fde" : undefined}>
              <th scope="row">{n}</th>
              {cells.map((c, i) => <td data-label={C.compare.cols[i + 1] + (lang === "fr" ? " :" : ":")}>{c}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fp-compare__note">{C.compare.note}</p>
  </div>
</section>

<section class="section fp-reg" aria-labelledby="fp-reg">
  <div class="wrap">
    <div class="fp-reg__head">
      <h2 id="fp-reg" class="h2">{C.regulated.h}</h2>
      <p class="lead">{C.regulated.lead}</p>
    </div>
    <div class="fp-reg__body">
      <div class="ph fp-reg__ph" data-reveal><Photo name="centre-donnees-45" sizes="(min-width: 900px) 34vw, 100vw" alt={lang === "en" ? "Rows of server cabinets in a data centre." : undefined} /></div>
      <dl class="fp-reg__list">
        {C.regulated.items.map((x) => <div><dt class="h3">{x.t}</dt><dd class="muted">{x.d}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<section class="section fp-keep band-alt" aria-labelledby="fp-keep">
  <div class="wrap fp-cols">
    <h2 id="fp-keep" class="h2">{C.keep.h}</h2>
    <p class="lead fp-keep__p">{C.keep.p}</p>
  </div>
</section>

<Formats lang={lang} />

<Faq id="fp-faq" title={C.faqTitle} items={C.faq} />

{lang === "fr" && (
  <section class="section section--tight fp-others" aria-labelledby="fp-others">
    <div class="wrap">
      <h2 id="fp-others" class="h3">{C.others}</h2>
      <ul role="list" class="fp-others__list">{others.map((m) => <li><a href={m.href}>{m.t}</a></li>)}</ul>
    </div>
  </section>
)}

<FinalCta lang={lang} />

<style>
  .fp-head { padding-block: var(--clx-space-7) var(--clx-layout-section); }
  .fp-head__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: end; }
  .fp-head__title { font-weight: 700; }
  .fp-head__term { display: block; font-size: var(--clx-type-h1-font-size); line-height: var(--clx-type-h1-line-height); letter-spacing: var(--clx-type-h1-letter-spacing); }
  .fp-head__claim { display: block; margin-top: var(--clx-space-4); font-size: var(--clx-type-h3-font-size); line-height: 1.25; font-weight: 500; color: var(--clx-text-muted); max-width: 30ch; }
  .fp-head__side { display: grid; gap: var(--clx-space-5); }
  .fp-head__chapo { font-size: var(--clx-type-lead-font-size); line-height: var(--clx-type-lead-line-height); color: var(--clx-text); max-width: 48ch; }
  .fp-head__cta { display: flex; flex-wrap: wrap; gap: var(--clx-space-3); }
  .fp-head__ph { margin-top: var(--clx-space-8); aspect-ratio: 16 / 9; }

  .fp-cols { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--clx-space-8); align-items: start; }
  .fp-prose { display: grid; gap: var(--clx-space-4); max-width: 62ch; }
  .fp-sub { margin-top: var(--clx-space-5); }
  .fp-src a { color: var(--clx-text-muted); }
  .fp-when__list { display: grid; gap: var(--clx-space-4); padding: 0; list-style: none; counter-reset: none; }
  .fp-when__list li { position: relative; padding: 0 0 var(--clx-space-4) 2rem; border-bottom: 1px solid var(--clx-border); max-width: 62ch; }
  .fp-when__list li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 1.1rem; height: 2px; background: var(--clx-accent); }

  .fp-method__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--clx-space-7); align-items: end; }
  .fp-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--clx-space-6); margin-top: var(--clx-space-8); }
  .fp-step { display: flex; flex-direction: column; }
  .fp-step__art { color: var(--clx-text); width: min(100%, 180px); aspect-ratio: 1; margin-bottom: var(--clx-space-5); }
  .fp-step__art :global(svg) { width: 100%; height: 100%; }
  .fp-step p.muted { margin-top: var(--clx-space-3); margin-bottom: var(--clx-space-4); }
  .fp-step__out { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding-top: var(--clx-space-3); border-top: 1px solid var(--clx-border); font-weight: 600; }
  .fp-step__out span + span { font-weight: 500; color: var(--clx-text-muted); }

  .fp-table { margin-top: var(--clx-space-7); overflow-x: auto; }
  .fp-table table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }
  .fp-table th, .fp-table td { padding: var(--clx-space-5) var(--clx-space-5) var(--clx-space-5) 0; border-bottom: 1px solid var(--clx-border-strong); vertical-align: top; }
  .fp-table thead th { font: 600 var(--clx-type-small-font-size)/1.4 var(--clx-font-family-text); color: var(--clx-text-muted); border-bottom: 2px solid var(--clx-text); }
  .fp-table thead td { border-bottom: 2px solid var(--clx-text); }
  .fp-table tbody th { font-family: var(--clx-font-family-display); font-weight: 500; font-size: 1.125rem; width: 24%; }
  .fp-table td { color: var(--clx-text-muted); }
  .fp-table tr.is-fde th, .fp-table tr.is-fde td { color: var(--clx-text); }
  .fp-table tr.is-fde th { color: var(--clx-accent); }
  .fp-compare__note { margin-top: var(--clx-space-6); font-family: var(--clx-font-family-voice); font-style: italic; font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); line-height: 1.35; max-width: 46ch; color: var(--clx-text); }

  .fp-reg__head { display: grid; gap: var(--clx-space-5); max-width: 56rem; }
  .fp-reg__head .lead { max-width: 60ch; }
  .fp-reg__body { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--clx-space-8); margin-top: var(--clx-space-8); align-items: start; }
  .fp-reg__ph { aspect-ratio: 4 / 5; }
  .fp-reg__list { display: grid; gap: 0; margin: 0; }
  .fp-reg__list div { padding-block: var(--clx-space-5); border-top: 1px solid var(--clx-border); }
  .fp-reg__list div:last-child { border-bottom: 1px solid var(--clx-border); }
  .fp-reg__list dt { font-size: 1.25rem; }
  .fp-reg__list dd { margin: var(--clx-space-2) 0 0; max-width: 56ch; }
  .fp-keep__p { max-width: 52ch; color: var(--clx-text); }

  .fp-others__list { display: flex; flex-wrap: wrap; gap: var(--clx-space-3) var(--clx-space-7); margin-top: var(--clx-space-4); }
  .fp-others__list a { color: var(--clx-text); text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; font-weight: 500; }

  @media (max-width: 1099px) { .fp-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--clx-space-8); } }
  @media (max-width: 899px) {
    .fp-head__in, .fp-cols, .fp-method__head, .fp-reg__body { grid-template-columns: 1fr; gap: var(--clx-space-6); }
    .fp-head__ph { margin-top: var(--clx-space-7); }
    .fp-reg__ph { aspect-ratio: 3 / 2; }
  }
  @media (max-width: 599px) {
    .fp-head__ph { aspect-ratio: 4 / 5; }
    .fp-steps { grid-template-columns: 1fr; gap: var(--clx-space-7); }
    .fp-step { display: grid; grid-template-columns: 88px minmax(0, 1fr); column-gap: var(--clx-space-5); align-items: start; }
    .fp-step__art { grid-row: span 3; width: 88px; margin: 0; }
    .fp-table table { min-width: 0; }
    .fp-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .fp-table table, .fp-table tbody, .fp-table tr, .fp-table th, .fp-table td { display: block; width: auto; }
    .fp-table tr { padding-block: var(--clx-space-5); border-bottom: 1px solid var(--clx-border-strong); }
    .fp-table th, .fp-table td { padding: 0; border: 0; width: auto; }
    .fp-table td { margin-top: var(--clx-space-2); }
    .fp-table td::before { content: attr(data-label) " "; font-weight: 600; color: var(--clx-text); }
  }
</style>
