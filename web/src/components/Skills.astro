---
// La boîte à outils complète, en six familles. L'ordre suit l'acheteur choisi (grand groupe, PME, cabinet).
// Sur l'accueil (collapsible), seules les trois familles les plus utiles à cet acheteur s'affichent d'abord.
const { collapsible = false } = Astro.props as { collapsible?: boolean };
interface Fam { t: string; d: string; tools: string[]; order: { groupe: number; pme: number; cabinet: number }; av?: boolean }
const families: Fam[] = [
  { t: "Achats et Source-to-Pay", d: "Politique achats en trois niveaux (politique, standards, playbooks), circuits d'achats tactiques, sourcing, contrats, direction des achats à temps partagé ou par intérim.", tools: ["SAP Ariba", "Source-to-Pay", "Sourcing et appels d'offres", "Contrats", "Fractional CPO"], order: { groupe: 1, pme: 4, cabinet: 1 } },
  { t: "Risques, conformité et gouvernance", d: "Registre d'information et risques TIC tiers, sous-traitance, cybersécurité, protection des données et usage responsable de l'IA, traduits en processus et en contrôles.", tools: ["DORA", "EBA Outsourcing", "NIS2 et CyFun", "TPRM", "RGPD", "AI Act"], order: { groupe: 2, pme: 5, cabinet: 2 } },
  { t: "Architecture d'entreprise et de solutions", d: "Cartographie applicative et des flux, architecture cible, rationalisation des outils, intégrations, choix de solutions et trajectoire chiffrée.", tools: ["Cartographie", "Architecture cible", "API et intégrations", "Cloud", "Données"], order: { groupe: 3, pme: 2, cabinet: 3 } },
  { t: "IA et agents", d: "Cas d'usage passés en production, agents qui travaillent dans vos outils, orchestration de plusieurs agents, garde-fous et traçabilité.", tools: ["Claude et Claude Code", "MCP", "Agents multiples", "RAG", "Garde-fous"], order: { groupe: 5, pme: 3, cabinet: 5 }, av: true },
  { t: "Ingénierie et produits numériques", d: "Sites, applications métier et SaaS construits et exploités : hébergement maîtrisé, déploiement automatisé, visibilité dans Google et les moteurs IA.", tools: ["Astro", "Python", "Node", "Docker", "Traefik", "HubSpot", "GEO"], order: { groupe: 6, pme: 1, cabinet: 6 }, av: true },
  { t: "Programmes et changement", d: "Programmes multi-équipes pilotés avec méthode, adoption mesurée, comités qui décident.", tools: ["PMP", "PRINCE2", "AgilePM", "SAFe", "Scrum", "ITIL v3", "ADKAR"], order: { groupe: 4, pme: 6, cabinet: 4 } },
];
---
<section id="competences" class="section skills band-alt" data-skills={collapsible ? "collapsible" : undefined} aria-labelledby="skills-title">
  <div class="wrap">
    <div class="skills__head">
      <h2 id="skills-title" class="h2">Six familles de compétences, un seul interlocuteur.</h2>
      <p class="lead">{collapsible ? "Six familles de compétences rarement réunies. Les trois plus utiles pour vous d'abord, les autres à un clic." : "Six familles de compétences rarement réunies, du conseil à la mise en production."}</p>
    </div>
    <ul role="list" class="skills__grid" id="skills-grid">
      {families.map((f) => (
        <li class:list={["skill", { "top-groupe": f.order.groupe <= 3, "top-pme": f.order.pme <= 3, "top-cabinet": f.order.cabinet <= 3 }]} style={`--o-groupe:${f.order.groupe}; --o-pme:${f.order.pme}; --o-cabinet:${f.order.cabinet};`}>
          <h3 class="h3">{f.t}</h3>
          <p class="muted">{f.d}</p>
          <p class={f.av ? "skill__tools small av" : "skill__tools small"}>{f.tools.join(", ")}</p>
        </li>
      ))}
    </ul>
    {collapsible && <button type="button" class="btn btn--secondary skills__more" aria-expanded="true" aria-controls="skills-grid" hidden>Voir les trois autres familles</button>}
    <p class="skills__lang small">Langues : français (langue maternelle), anglais courant, néerlandais opérationnel.</p>
  </div>
</section>

<script>
  // repli progressif : sans JavaScript, les six familles restent visibles
  const sec = document.querySelector<HTMLElement>('[data-skills="collapsible"]');
  const btn = sec?.querySelector<HTMLButtonElement>(".skills__more");
  if (sec && btn) {
    const set = (open: boolean) => {
      sec.classList.toggle("is-collapsed", !open);
      btn.setAttribute("aria-expanded", String(open));
      btn.textContent = open ? "Afficher les trois principales" : "Voir les trois autres familles";
    };
    btn.hidden = false;
    set(false);
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  }
</script>

<style>
  .skills__head { display: grid; gap: var(--clx-space-5); max-width: 52rem; }
  .skills__head .lead { max-width: 52ch; }
  .skills__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-7) var(--clx-space-6); margin-top: var(--clx-space-8); }
  .skill { order: var(--o-groupe); display: grid; gap: var(--clx-space-3); align-content: start; padding-top: var(--clx-space-4); border-top: 2px solid var(--clx-text); }
  :global(html[data-audience="pme"]) .skill, :global(:root:has(#aud-pme:checked)) .skill { order: var(--o-pme); }
  :global(html[data-audience="cabinet"]) .skill, :global(:root:has(#aud-cabinet:checked)) .skill { order: var(--o-cabinet); }
  :global(:root:has(#aud-groupe:checked)) .skill { order: var(--o-groupe); }
  .skill__tools { color: var(--clx-text); font-weight: 500; }
  /* repli : les trois familles les plus utiles à l'acheteur choisi */
  .skills.is-collapsed .skill:not(.top-groupe) { display: none; }
  :global(html[data-audience="pme"]) .skills.is-collapsed .skill:not(.top-groupe),
  :global(html[data-audience="cabinet"]) .skills.is-collapsed .skill:not(.top-groupe),
  :global(:root:has(#aud-pme:checked)) .skills.is-collapsed .skill:not(.top-groupe),
  :global(:root:has(#aud-cabinet:checked)) .skills.is-collapsed .skill:not(.top-groupe) { display: grid; }
  :global(html[data-audience="pme"]) .skills.is-collapsed .skill:not(.top-pme),
  :global(:root:has(#aud-pme:checked)) .skills.is-collapsed .skill:not(.top-pme) { display: none; }
  :global(html[data-audience="cabinet"]) .skills.is-collapsed .skill:not(.top-cabinet),
  :global(:root:has(#aud-cabinet:checked)) .skills.is-collapsed .skill:not(.top-cabinet) { display: none; }
  :global(:root:has(#aud-groupe:checked)) .skills.is-collapsed .skill:not(.top-groupe) { display: none; }
  .skills__more { margin-top: var(--clx-space-7); }
  .skills__lang { margin-top: var(--clx-space-7); color: var(--clx-text-muted); }
  @media (max-width: 1099px) { .skills__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .skills__grid { grid-template-columns: 1fr; gap: var(--clx-space-6); } }
</style>
