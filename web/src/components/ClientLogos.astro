---
// « Là où nous avons travaillé » : fichiers officiels (registre src/data/clients.registry.json), teintés par masque CSS.
// Équilibrage optique : surface visuelle constante, corrigée par la densité d'encre mesurée par scripts/build-clients.mjs.
// Ce ne sont pas des références de projets : aucun projet n'est détaillé.
import clients from "../data/clients.json";
import { t, langOf, ANCHORS } from "../i18n";
const lang = langOf(Astro.url.pathname);
const R = t(lang).home.refs;
interface Logo { id: string; name: string; group: string; aspect: number; density: number; echelle?: number }
const BASE = 40;      // hauteur de référence d'un logo carré, en px
const REF_DENSITY = 0.4;
const size = (l: Logo) => {
  let h = BASE / Math.sqrt(l.aspect) * 1.6;
  h *= Math.pow(REF_DENSITY / l.density, 0.3);
  h = Math.max(24, Math.min(60, h)) * (l.echelle ?? 1);
  return { h: Math.round(h), w: Math.round(h * l.aspect) };
};
const logos = clients as Logo[];
---
<section id={ANCHORS.refs[lang]} class="refs" aria-labelledby="refs-title">
  <div class="wrap">
    <div class="refs__head">
      <h2 id="refs-title" class="refs__title">{R.title}</h2>
      <p class="refs__note">{R.note}</p>
    </div>
    <ul role="list" class="refs__list">
      {logos.map((l) => {
        const s = size(l);
        return (
          <li>
            <span class="refs__logo" role="img" aria-label={l.name} style={`--src:url(/clients/${l.id}.svg); width:${s.w}px; height:${s.h}px;`} />
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .refs { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); border-bottom: 1px solid var(--clx-border); }
  .refs__head { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--clx-space-7); align-items: baseline; }
  .refs__title { font-size: var(--clx-type-h3-font-size); line-height: 1.2; font-weight: 500; letter-spacing: -0.01em; }
  .refs__note { color: var(--clx-text-muted); max-width: 60ch; }
  /* rangées centrées : le nombre de logos par rangée suit la largeur (7, 5, 3 puis 2), la dernière rangée reste au centre */
  .refs__list { --n: 7; --g: var(--clx-space-6); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--clx-space-7) var(--g); margin-top: var(--clx-space-8); }
  .refs__list li { display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; min-height: 64px; flex: 0 0 calc((100% - (var(--n) - 1) * var(--g)) / var(--n)); min-width: 0; }
  @media (max-width: 1099px) { .refs__list { --n: 5; } }
  .refs__logo {
    display: block; max-width: 100%; background-color: var(--clx-text-muted);
    -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat;
  }
  @media (forced-colors: active) { .refs__logo { background-color: CanvasText; forced-color-adjust: none; } }
  @media (max-width: 899px) {
    .refs__head { grid-template-columns: 1fr; gap: var(--clx-space-3); }
    .refs__list { --g: var(--clx-space-5); row-gap: var(--clx-space-6); margin-top: var(--clx-space-7); }
  }
  @media (max-width: 699px) { .refs__list { --n: 3; } }
  @media (max-width: 479px) { .refs__list { --n: 2; } }
</style>
