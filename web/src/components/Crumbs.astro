---
// Fil d'Ariane visible ; le BreadcrumbList JSON-LD est construit par la page avec la même liste.
interface Props { items: { name: string; href?: string }[]; label?: string }
const { items, label = "Fil d'Ariane" } = Astro.props;
---
<nav class="wrap crumbs small" aria-label={label}>
  <ol role="list">
    {items.map((c, i) => <li>{c.href && i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
  </ol>
</nav>

<style>
  .crumbs { padding-top: var(--clx-space-5); color: var(--clx-text-muted); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; }
  .crumbs li { white-space: nowrap; }
  .crumbs li + li::before { content: "/"; margin-right: 0.5rem; color: var(--clx-border-strong); }
  .crumbs a { color: var(--clx-text-muted); }
</style>
