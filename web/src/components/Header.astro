---
import wordmark from "../assets/x/wordmark.svg?raw";
import { t, langOf, ROUTES, LANG_NAMES, type Lang } from "../i18n";
interface Props { alternates?: { lang: string; path: string; code: Lang }[] }
const { alternates = [] } = Astro.props;
const current = Astro.url.pathname;
const lang = langOf(current);
const L = t(lang).common.header;
const nav = L.nav;
// les trois langues : vers la même page traduite quand elle existe, sinon vers l'accueil de la langue
const langs = (["fr", "nl", "en"] as Lang[]).map((code) => ({ code, href: alternates.find((a) => a.code === code)?.path ?? ROUTES.home[code], ...LANG_NAMES[code] }));
const isCurrent = (href: string) => !href.includes("#") && current === href;
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__logo" href={ROUTES.home[lang]} aria-label={L.home}>
      <span class="hd__mark" set:html={wordmark} aria-hidden="true" />
    </a>
    <nav class="hd__nav" aria-label={L.main}>
      <ul role="list">
        {nav.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}{isCurrent(l.href) && <span class="hd__cur" aria-hidden="true" />}</a></li>)}
      </ul>
    </nav>
    <ul role="list" class="hd__langs" aria-label={L.languages}>
      {langs.map((x) => (
        <li>{x.code === lang
          ? <span class="hd__lang is-on" aria-current="true"><abbr title={x.name}>{x.short}</abbr></span>
          : <a class="hd__lang" href={x.href} hreflang={x.code} lang={x.code} aria-label={`${x.short}, ${x.name}`}>{x.short}</a>}</li>
      ))}
    </ul>
    <a class="btn btn--primary btn--small hd__cta" href="#contact"><span class="hd__cta-l">{L.cta}</span><span class="hd__cta-s">{L.ctaShort}</span></a>
    <button type="button" class="hd__toggle" popovertarget="menu" aria-controls="menu" aria-expanded="false" aria-label={L.open}><span>{L.menu}</span></button>
    <nav id="menu" class="hd__menu" popover aria-label={L.mobile}>
      <ul role="list">
        {nav.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a></li>)}
        <li><a href="#contact">{L.contact}</a></li>
        <li class="hd__menu-langs"><ul role="list" aria-label={L.languages}>{langs.map((x) => <li>{x.code === lang ? <span aria-current="true">{x.name}</span> : <a href={x.href} hreflang={x.code} lang={x.code}>{x.name}</a>}</li>)}</ul></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // menu mobile : popover natif (Échap et clic extérieur le ferment) ; il se referme aussi quand on suit un lien.
  // Tant qu'il est ouvert, main et footer sont inert : le focus clavier ne peut plus atterrir sur un élément recouvert
  // (WCAG 2.2 SC 2.4.11), la tabulation reste dans le panneau et le focus revient au déclencheur à la fermeture.
  const menu = document.getElementById("menu");
  const toggle = document.querySelector<HTMLButtonElement>(".hd__toggle");
  if (menu && toggle) {
    const behind = [document.querySelector("main"), document.querySelector("footer")];
    const links = [...menu.querySelectorAll<HTMLAnchorElement>("a[href]")];
    const last = links[links.length - 1];
    let closingByLink = false;
    // le fond (contenu et pied de page) sort de l'ordre de tabulation et de l'arbre des lecteurs d'écran
    const setBackgroundInert = (open: boolean) => behind.forEach((n) => { if (n) n.inert = open; });
    // état du panneau (le sélecteur n'est reconnu que là où popover est pris en charge)
    const isOpen = () => { try { return menu.matches(":popover-open"); } catch { return false; } };

    menu.addEventListener("toggle", (e) => {
      const open = e.newState === "open";
      setBackgroundInert(open);
      toggle.setAttribute("aria-expanded", String(open));
      if (open) requestAnimationFrame(() => links[0]?.focus());
      // Échap, clic extérieur ou bouton : le focus revient au déclencheur (sauf si un lien vient d'être suivi)
      else if (!closingByLink) toggle.focus();
      closingByLink = false;
    });

    // le panneau forme une boucle avec son bouton : du dernier lien, Tab revient au bouton, puis au premier lien
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Tab" && !e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        toggle.focus();
      }
    });

    // suivre un lien referme le panneau sans reprendre le focus : la cible du lien le reçoit (gestion des ancres ci-dessous).
    // L'inertie du fond est retirée tout de suite, sans attendre la tâche "toggle" : le focus de la cible serait refusé.
    links.forEach((a) => a.addEventListener("click", () => {
      if (!isOpen()) return;
      closingByLink = true;
      menu.hidePopover();
      setBackgroundInert(false);
    }));

    // liens internes (#contact, #methode, #references) : la cible reçoit le focus pour que l'indicateur reste visible.
    // Le défilement est celui de l'ancre (scroll-padding-top de global.css dégage l'en-tête collant).
    const focusHash = (hash: string) => {
      if (hash.length < 2) return;
      let id = hash.slice(1);
      try { id = decodeURIComponent(id); } catch { /* hash non encodé : on garde la valeur brute */ }
      const target = document.getElementById(id);
      if (!target) return;
      // le panneau mobile peut être en cours de fermeture : on lève l'inertie du fond tout de suite, sinon le focus
      // de la cible serait refusé puis repris par le déclencheur
      if (target.closest("[inert]")) {
        closingByLink = true;
        setBackgroundInert(false);
      }
      target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    };
    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      const a = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
      if (!a) return;
      // ancre activée hors du panneau alors qu'il est encore ouvert (lien d'en-tête au clavier) : on le referme d'abord
      if (isOpen() && !menu.contains(a)) {
        closingByLink = true;
        menu.hidePopover();
        setBackgroundInert(false);
      }
      focusHash(a.getAttribute("href") ?? "");
    });
    // retour depuis le cache (bfcache) : l'état du panneau peut être restauré sans événement "toggle"
    addEventListener("pageshow", () => {
      const open = isOpen();
      setBackgroundInert(open);
      toggle.setAttribute("aria-expanded", String(open));
    });
    // le panneau n'existe qu'en dessous de 1200 px : au-delà, il faut le refermer, sinon le fond resterait inerte
    const narrow = matchMedia("(max-width: 1199px)");
    narrow.addEventListener("change", () => {
      if (narrow.matches || !isOpen()) return;
      closingByLink = true; // le déclencheur est masqué à cette largeur : pas de retour de focus
      menu.hidePopover();
      setBackgroundInert(false);
      toggle.setAttribute("aria-expanded", "false");
    });
    // arrivée avec une ancre dans l'URL (/contact/#… ou lien depuis une autre page)
    if (location.hash) focusHash(location.hash);
  }
</script>

<style>
  .hd { position: sticky; top: 0; z-index: 50; background: var(--clx-bg); border-bottom: 1px solid transparent; }
  @supports (animation-timeline: scroll()) {
    .hd { animation: hd-line linear both; animation-timeline: scroll(root); animation-range: 0 120px; }
    @keyframes hd-line { to { border-bottom-color: var(--clx-border); } }
  }
  @supports not (animation-timeline: scroll()) { .hd { border-bottom-color: var(--clx-border); } }
  .hd__in { display: flex; align-items: center; gap: var(--clx-space-6); min-height: 72px; }
  .hd__logo { display: inline-flex; align-items: center; min-height: 44px; color: var(--clx-text); flex: none; border-radius: 4px; }
  .hd__mark :global(svg) { width: 132px; height: auto; }
  .hd__nav { margin-left: auto; }
  .hd__nav ul { display: flex; gap: var(--clx-space-6); }
  .hd__nav a, .hd__menu a { color: var(--clx-text); text-decoration: none; font-weight: 500; font-size: 0.9375rem; padding: 0.5rem 0; }
  .hd__nav a { position: relative; white-space: nowrap; }
  @media (max-width: 1279px) { .hd__nav ul { gap: var(--clx-space-5); } .hd__in { gap: var(--clx-space-5); } }
  .hd__nav a:hover { color: var(--clx-link); }
  /* langues : trois codes, la langue courante soulignée ; les autres sont des liens vers la même page traduite */
  .hd__langs { display: flex; gap: 0.125rem; margin-left: calc(var(--clx-space-2) * -1); }
  .hd__lang { display: inline-grid; place-items: center; min-width: 32px; min-height: 44px; font: 600 0.8125rem/1 var(--clx-font-family-text); letter-spacing: 0.04em; color: var(--clx-text-muted); text-decoration: none; position: relative; }
  .hd__lang abbr { text-decoration: none; }
  a.hd__lang:hover { color: var(--clx-text); }
  .hd__lang.is-on { color: var(--clx-text); }
  /* état courant (langue, page) : le filet passe de --clx-accent à --clx-link.
     Contraste calculé selon WCAG 2.x : --clx-link #0C7893 sur --clx-bg #F6F5F0 = 4,67:1 (seuil SC 1.4.11 : 3:1) ;
     sur Encre, --clx-link #19B3D9 sur #0B2239 = 6,52:1. L'ancien filet en --clx-accent #19B3D9 n'atteignait que 2,27:1 sur Papier. */
  .hd__lang.is-on::after { content: ""; position: absolute; left: 25%; right: 25%; bottom: 10px; height: 2px; background: var(--clx-link); }
  /* page courante : un filet sous le lien */
  .hd__cur { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--clx-link); view-transition-name: clx-cur; }
  .hd__toggle, .hd__menu { display: none; }
  @media (max-width: 1199px) {
    .hd__in { gap: var(--clx-space-3); min-height: 64px; }
    .hd__mark :global(svg) { width: 112px; }
    .hd__nav, .hd__langs { display: none; }
    .hd__cta { margin-left: auto; }
    .hd__toggle { display: grid; place-items: center; cursor: pointer; min-height: 44px; min-width: 44px; border-radius: var(--clx-radius-pill); border: 1px solid var(--clx-border-strong); background: transparent; color: var(--clx-text); padding: 0 0.875rem; font: 600 0.9375rem/1 var(--clx-font-family-text); }
    .hd__toggle:hover { border-color: var(--clx-text); }
    .hd__menu:popover-open { display: block; }
    .hd__menu { position: fixed; inset: 64px 0 auto 0; margin: 0; width: auto; max-height: calc(100svh - 64px); overflow: auto; border: 0; border-bottom: 1px solid var(--clx-border); background: var(--clx-bg); color: var(--clx-text); padding: var(--clx-space-3) max(var(--clx-layout-gutter), env(safe-area-inset-right, 0px)) var(--clx-space-6) max(var(--clx-layout-gutter), env(safe-area-inset-left, 0px)); }
    .hd__menu a { display: block; font-size: 1.25rem; font-family: var(--clx-font-family-display); font-weight: 500; padding: 0.75rem 0; }
    .hd__menu a[aria-current="page"] { color: var(--clx-link); }
    .hd__menu-langs { margin-top: var(--clx-space-4); padding-top: var(--clx-space-4); border-top: 1px solid var(--clx-border); }
    .hd__menu-langs ul { display: flex; flex-wrap: wrap; gap: var(--clx-space-5); }
    .hd__menu-langs a, .hd__menu-langs span { font-family: var(--clx-font-family-text); font-size: 1rem; font-weight: 500; padding: 0.75rem 0; display: block; }
    .hd__menu-langs span { color: var(--clx-text-muted); }
    .hd__menu::backdrop { background: rgb(11 34 57 / 0.35); }
  }
  /* ouverture du menu : un glissement court, sans rebond */
  @media (prefers-reduced-motion: no-preference) {
    .hd__menu { transition: opacity 240ms var(--clx-easing-out), translate 240ms var(--clx-easing-out), display 240ms allow-discrete, overlay 240ms allow-discrete; }
    .hd__menu:popover-open { opacity: 1; translate: 0 0; }
    @starting-style { .hd__menu:popover-open { opacity: 0; translate: 0 -8px; } }
  }
  .hd__cta-s { display: none; }
  @media (max-width: 479px) { .hd__cta-l { display: none; } .hd__cta-s { display: inline; } .hd__cta { padding: 0 0.875rem; } }
  @media (max-width: 339px) { .hd__mark :global(svg) { width: 96px; } }
</style>
