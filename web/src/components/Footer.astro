---
import { SITE } from "../data/site";
import { t, langOf, ROUTES, LANG_NAMES, type Lang } from "../i18n";
const lang = langOf(Astro.url.pathname);
const { common: C, metiers } = t(lang);
const F = C.footer;
const year = new Date().getFullYear();
const others = (["fr", "nl", "en"] as Lang[]).filter((l) => l !== lang);
---
<footer class="ft" data-theme="encre">
  <div class="wrap ft__in">
    <div class="ft__brand">
      <img src="/brand/clixite-relief-inverse.svg" alt="Clixite, Enterprise & Solution Architecture" width="240" height="91" decoding="async" />
    </div>
    <div class="ft__cols">
      <div>
        <p class="ft__label">{F.contact}</p>
        <ul role="list">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          {SITE.phones.map((p) => <li>{C.countries[p.country]}{C.colon} <a href={`tel:${p.tel}`} class="ft__tel">{p.display}</a></li>)}
          <li>{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}, {C.country}</li>
        </ul>
      </div>
      <div>
        <p class="ft__label">{F.expertise}</p>
        <ul role="list">
          {metiers.list.map((m) => <li><a href={m.href}>{m.t}</a></li>)}
          <li><a href={ROUTES.achats[lang]}>{F.achats}</a></li>
        </ul>
      </div>
      <div>
        <p class="ft__label">{F.info}</p>
        <ul role="list">
          <li><a href={ROUTES.about[lang]}>{F.about}</a></li>
          <li><a href={ROUTES.contact[lang]}>{F.contactPage}</a></li>
          <li><a href={ROUTES.legal[lang]}>{F.legal}</a></li>
          <li><a href={SITE.charte}>{F.charte}</a></li>
          <li><a href="/llms.txt">{F.llms}</a></li>
          {others.map((l) => <li><a href={ROUTES.home[l]} hreflang={l} lang={l}>{LANG_NAMES[l].name}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="ft__legal small"><span class="av">{SITE.legalName}, {F.legalLine} {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}. {F.vat} {SITE.vat}, {F.rpm}.</span> {F.since} {year}.</p>
  </div>
</footer>

<style>
  .ft { padding-block: var(--clx-space-8) var(--clx-space-7); }
  .ft__in { display: grid; gap: var(--clx-space-8); }
  .ft__brand img { width: 240px; height: auto; margin-left: -4px; }
  .ft__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-6); }
  .ft__cols ul { display: grid; gap: 0.25rem; }
  .ft__cols li { min-height: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.3em; }
  .ft__label { font-weight: 600; margin-bottom: 0.5rem; }
  .ft a { color: var(--clx-text); text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  .ft a:hover { color: var(--clx-link); }
  .ft__legal { color: var(--clx-text-muted); }
  .ft__tel { white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) { .ft__cols { grid-template-columns: 1fr; } }
</style>
