---
import { SITE } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="ft" data-theme="encre">
  <div class="wrap ft__in">
    <div class="ft__brand">
      <img src="/brand/clixite-relief-inverse.svg" alt="Clixite, Enterprise & Solution Architecture" width="240" height="91" decoding="async" />
    </div>
    <div class="ft__cols">
      <div>
        <p class="ft__label">Contact</p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p><a href={SITE.linkedin} rel="me noopener">Nicolas Simon sur LinkedIn</a></p>
        <p>{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}, Belgique</p>
      </div>
      <div>
        <p class="ft__label">Expertises</p>
        <p><a href="/expertises/">Les six expertises</a></p>
        <p><a href="/expertises/transformation-achats/">Transformation des achats</a></p>
        <p><a href="/#offres">Offres de démarrage</a></p>
      </div>
      <div>
        <p class="ft__label">Informations</p>
        <p><a href="/mentions-legales/">Mentions légales et confidentialité</a></p>
        <p><a href={SITE.charte}>Charte graphique</a></p>
        <p><a href="/llms.txt">Résumé pour les assistants IA</a></p>
      </div>
    </div>
    <p class="ft__legal small"><span class="av">{SITE.legalName}, société à responsabilité limitée. Siège : {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}. BCE et TVA {SITE.vat}, RPM Brabant wallon.</span> © 2005 à {year}.</p>
  </div>
</footer>

<style>
  .ft { padding-block: var(--clx-space-8) var(--clx-space-7); }
  .ft__in { display: grid; gap: var(--clx-space-8); }
  .ft__brand img { width: 240px; height: auto; }
  .ft__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--clx-space-6); }
  .ft__cols p + p { margin-top: 0.375rem; }
  .ft__label { font-weight: 600; margin-bottom: 0.5rem; }
  .ft a { color: var(--clx-text); text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  .ft a:hover { color: var(--clx-link); }
  .ft__legal { color: var(--clx-text-muted); }
  @media (max-width: 767px) { .ft__cols { grid-template-columns: 1fr; } }
</style>
