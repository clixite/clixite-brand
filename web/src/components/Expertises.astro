---
// Les quatre métiers de Clixite, puis les domaines où ils s'appliquent. Utilisé sur l'accueil (h2) et sur /expertises/ (h1).
interface Props { headingLevel?: "h1" | "h2" }
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const Item = headingLevel === "h1" ? "h2" : "h3";
const pillars = [
  { t: "Digitalisation", d: "Les processus papier, les doubles saisies et les fichiers éparpillés deviennent des outils reliés qui travaillent pour vos équipes.",
    g: ["Processus cartographiés et simplifiés avant d'être outillés", "Formulaires, flux et validations automatisés", "Données reliées entre vos outils, tableaux de bord utilisés"], k: "Automatisation, CRM et ERP, données, IA appliquée" },
  { t: "Forward Deployed Engineering", d: "Nous nous installons dans vos équipes, nous construisons avec elles et nous restons jusqu'à la mise en production. La solution tourne avant notre départ.",
    g: ["Intégrés à vos équipes, sur site ou à distance", "Prototype, mise en production, puis transfert", "Intégrations et agents IA sous garde-fous"], k: "Intégration, agents IA, mise en production, transfert" },
  { t: "Pilotage de programmes", d: "Des programmes multi-équipes cadrés et tenus : une gouvernance claire, des risques suivis, des comités qui décident, des utilisateurs embarqués dès le premier jour.",
    g: ["Plan, budget et risques repris en main", "Gouvernance et comités qui tranchent", "Conduite du changement mesurée"], k: "PMP, PRINCE2, SAFe, Scrum, ADKAR" },
  { t: "Architecture d'entreprise et de solutions", d: "Savoir ce que vous avez, décider où vous allez et choisir les solutions qui vous y mènent, sans empiler les outils.",
    g: ["Cartographie des applications, des données et des flux", "Architecture cible et trajectoire en options chiffrées", "Choix de solutions et revues d'architecture indépendantes"], k: "Cartographie, architecture cible, intégration, cloud" },
];
const domains = [
  { t: "Achats et Source-to-Pay", href: "/expertises/transformation-achats/" },
  { t: "Risques et conformité : DORA, NIS2, RGPD, AI Act" },
  { t: "IA en production" },
  { t: "Produits numériques et SaaS" },
];
---
<section id="expertises" class:list={["section", "expertises", headingLevel === "h1" && "expertises--page"]} aria-labelledby="exp-title">
  <div class="wrap">
    <div class="exp__head">
      <Heading id="exp-title" class={headingLevel === "h1" ? "h-display" : "h2"}>Quatre métiers, un même résultat : des solutions qui tournent.</Heading>
      <p class="lead">Nous intervenons là où une stratégie doit devenir un système qui fonctionne, dans une PME comme dans un groupe régulé.</p>
    </div>
    <ul role="list" class="exp__grid">
      {pillars.map((p) => (
        <li class="exp__pillar">
          <Item class="h3">{p.t}</Item>
          <p class="muted">{p.d}</p>
          <ul class="exp__gets">{p.g.map((x) => <li>{x}</li>)}</ul>
          <p class="exp__k small">{p.k}</p>
        </li>
      ))}
    </ul>
    <div class="exp__domains">
      <p class="exp__dlabel">Ces quatre métiers s'appliquent aussi à</p>
      <ul role="list">
        {domains.map((d) => <li>{d.href ? <a href={d.href}>{d.t}</a> : d.t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .expertises--page { padding-top: var(--clx-space-7); }
  .exp__head { display: grid; gap: var(--clx-space-5); max-width: 56rem; }
  .exp__head :is(h1, h2) { text-wrap: balance; }
  .exp__head .lead { max-width: 52ch; }
  .exp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--clx-space-8) var(--clx-space-8); margin-top: var(--clx-space-8); }
  .exp__pillar { display: grid; gap: var(--clx-space-3); align-content: start; padding-top: var(--clx-space-5); border-top: 2px solid var(--clx-text); }
  .exp__pillar p.muted { max-width: 52ch; }
  .exp__gets { margin: var(--clx-space-2) 0 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .exp__gets li::marker { color: var(--clx-accent); }
  .exp__k { margin-top: var(--clx-space-2); color: var(--clx-text); font-weight: 500; }
  .exp__domains { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--clx-space-6); margin-top: var(--clx-space-9); padding-top: var(--clx-space-6); border-top: 1px solid var(--clx-border); align-items: baseline; }
  .exp__dlabel { font-family: var(--clx-font-family-display); font-weight: 500; font-size: 1.125rem; }
  .exp__domains ul { display: flex; flex-wrap: wrap; gap: var(--clx-space-3) var(--clx-space-6); }
  .exp__domains li { color: var(--clx-text); }
  .exp__domains a { color: var(--clx-text); text-decoration: underline; text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 899px) {
    .exp__grid { grid-template-columns: 1fr; gap: var(--clx-space-7); }
    .exp__domains { grid-template-columns: 1fr; gap: var(--clx-space-3); }
    .exp__domains ul { flex-direction: column; gap: var(--clx-space-2); }
  }
</style>
