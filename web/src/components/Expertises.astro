---
interface Props { headingLevel?: "h1" | "h2" }
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const Item = headingLevel === "h1" ? "h2" : "h3";
const items = [
  { t: "Architecture d'entreprise et de solutions", d: "Cartographie applicative, architecture cible, rationalisation des outils, intégrations et choix de solutions, du cloud au poste de travail.", k: "Cible, feuille de route, intégration" },
  { t: "Transformation des achats", d: "Source-to-Pay, du sourcing au paiement, mise en place d'outils comme SAP Ariba, direction des achats à temps partagé ou par intérim.", k: "Source-to-Pay, Fractional CPO, intérim", href: "/expertises/transformation-achats/" },
  { t: "Gouvernance, risque et conformité", d: "Mise en conformité DORA et NIS2, gestion des risques tiers, RGPD et AI Act, traduites en processus et en contrôles qui tiennent.", k: "DORA, NIS2, TPRM, RGPD, AI Act" },
  { t: "Industrialisation de l'IA", d: "Des cas d'usage qui passent du prototype à la production : agents, recherche documentaire, automatisation, avec garde-fous et traçabilité.", k: "Agents, RAG, garde-fous, AI Act" },
  { t: "Produits numériques et ingénierie", d: "Sites, applications métier et SaaS conçus pour durer : architecture propre, déploiement automatisé, coûts maîtrisés.", k: "Web, applications, SaaS, DevOps" },
  { t: "Pilotage de programmes et changement", d: "Programmes multi-équipes pilotés avec méthode, et une conduite du changement qui embarque les utilisateurs dès le premier jour.", k: "PMP, PRINCE2, SAFe, ADKAR" },
];
---
<section id="expertises" class:list={["section", "expertises", headingLevel === "h1" && "expertises--page"]} aria-labelledby="exp-title">
  <div class="wrap">
    <div class="exp__head">
      <Heading id="exp-title" class={headingLevel === "h1" ? "h-display" : "h2"}>Six terrains, une seule architecture.</Heading>
      <p class="lead">Les mêmes principes s'appliquent à une banque et à une PME : savoir ce qu'on a, décider où on va, livrer ce qui compte.</p>
    </div>
    <ul role="list" class="exp__list">
      {items.map((i) => (
        <li class="exp__row">
          <Item class="h3">{i.href ? <a href={i.href}>{i.t}</a> : i.t}</Item>
          <div class="exp__body">
            <p class="muted">{i.d}</p>
            <p class="exp__k small">{i.k}</p>
          </div>
          {i.href ? <a class="link-more small exp__more" href={i.href} aria-hidden="true" tabindex="-1">Lire la page</a> : <span class="exp__more" aria-hidden="true"></span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .expertises--page { padding-top: var(--clx-space-7); }
  .exp__head { display: grid; gap: var(--clx-space-5); max-width: 52rem; }
  .exp__head .lead { max-width: 46ch; }
  .exp__list { margin-top: var(--clx-space-8); border-top: 1px solid var(--clx-border); }
  .exp__row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 8rem; gap: var(--clx-space-6); padding-block: var(--clx-space-6); border-bottom: 1px solid var(--clx-border); align-items: baseline; }
  .exp__row .h3 a { color: inherit; text-decoration: underline; text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .exp__row .h3 a:hover { color: var(--clx-link); }
  .exp__body p.muted { max-width: 58ch; }
  .exp__k { margin-top: var(--clx-space-3); color: var(--clx-text); font-weight: 500; }
  .exp__more { justify-self: end; }
  @media (max-width: 899px) {
    .exp__row { grid-template-columns: 1fr; gap: var(--clx-space-3); }
    .exp__more { justify-self: start; }
    .exp__more:empty { display: none; }
  }
</style>
