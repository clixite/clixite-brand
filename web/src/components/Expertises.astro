---
// Les cinq métiers sur l'accueil, le Forward Deployed Engineering et le GEO en tête ; chaque titre mène à sa page.
import Photo from "./Photo.astro";
import { METIERS, DOMAINES } from "../data/expertises";
---
<section id="expertises" class="section expertises" aria-labelledby="exp-title">
  <div class="wrap">
    <div class="exp__head">
      <div class="exp__intro">
        <h2 id="exp-title" class="h2">Cinq métiers, une même exigence : un résultat qui tourne.</h2>
        <p class="lead">Nous intervenons là où une stratégie doit devenir un système qui fonctionne, dans une PME comme dans un groupe régulé.</p>
      </div>
      <figure class="exp__fig">
        <Photo name="plan-32" class="exp__img" sizes="(min-width: 900px) 40vw, 100vw" />
      </figure>
    </div>
    <ul role="list" class="exp__grid">
      {METIERS.map((p) => (
        <li class="exp__pillar">
          <h3 class="h3"><a href={p.href}>{p.t}</a></h3>
          <p class="muted">{p.d}</p>
          <ul class="exp__gets">{p.g.map((x) => <li>{x}</li>)}</ul>
          <p class="exp__k small">{p.k}</p>
        </li>
      ))}
    </ul>
    <div class="exp__domains">
      <p class="exp__dlabel">Domaines d'application</p>
      <ul role="list">
        {DOMAINES.map((d) => <li>{d.href ? <a href={d.href}>{d.t}</a> : d.t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .exp__head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--clx-space-8); align-items: end; }
  .exp__intro { display: grid; gap: var(--clx-space-5); }
  .exp__intro .lead { max-width: 52ch; }
  .exp__fig { margin: 0; }
  .exp__fig :global(.exp__img) { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--clx-radius-panel); }
  .exp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--clx-space-8); margin-top: var(--clx-space-8); }
  .exp__pillar { display: grid; gap: var(--clx-space-3); align-content: start; padding-top: var(--clx-space-5); border-top: 2px solid var(--clx-text); }
  .exp__pillar:nth-child(-n + 2) { border-top-color: var(--clx-accent); }
  .exp__pillar h3 a { color: var(--clx-text); text-decoration: none; background-image: none; }
  .exp__pillar h3 a:hover { color: var(--clx-link); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .exp__pillar p.muted { max-width: 52ch; }
  .exp__gets { margin: var(--clx-space-2) 0 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .exp__gets li::marker { color: var(--clx-accent); }
  .exp__k { margin-top: var(--clx-space-2); color: var(--clx-text); font-weight: 500; }
  .exp__domains { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--clx-space-6); margin-top: var(--clx-space-9); padding-top: var(--clx-space-6); border-top: 1px solid var(--clx-border); align-items: baseline; }
  .exp__dlabel { font-family: var(--clx-font-family-display); font-weight: 500; font-size: 1.125rem; }
  .exp__domains ul { display: flex; flex-wrap: wrap; gap: var(--clx-space-3) var(--clx-space-6); }
  .exp__domains li { color: var(--clx-text); }
  .exp__domains a { color: var(--clx-text); text-decoration: underline; text-decoration-color: var(--clx-accent); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 899px) {
    .exp__head { grid-template-columns: 1fr; gap: var(--clx-space-6); }
    .exp__grid { grid-template-columns: 1fr; gap: var(--clx-space-7); }
    .exp__domains { grid-template-columns: 1fr; gap: var(--clx-space-3); }
    .exp__domains ul { flex-direction: column; gap: var(--clx-space-2); }
  }
  /* sur téléphone, les puces restent sur les pages métiers : l'offre arrive plus tôt sous le pouce */
  @media (max-width: 599px) { .exp__gets, .exp__k { display: none; } }
</style>
