{
  "name": "clixite-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "www.clixite.be, refonte 2030 (Astro, Design System 2.0)",
  "scripts": {
    "tokens": "node ../ds/build-tokens.mjs && node -e \"require('node:fs').copyFileSync('../ds/dist/tokens.css','src/styles/tokens.css')\"",
    "clients": "node scripts/build-clients.mjs",
    "x": "python3 scripts/gen_x.py",
    "prebuild": "npm run tokens",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "postbuild": "node scripts/typo-fr.mjs dist && node scripts/build-llms.mjs dist",
    "build:review": "PUBLIC_REVIEW=1 astro build --outDir dist-review && node scripts/typo-fr.mjs dist-review"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "lucide-static": "1.61.0",
    "node-html-markdown": "2.0.0",
    "typescript": "^5.9.3"
  }
}
